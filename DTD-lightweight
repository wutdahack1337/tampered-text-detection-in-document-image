   total_dice = 0.0\n","    total_images = 0\n","\n","    progress_bar = tqdm(loader, desc=f\"Evaluating {dataset_name}\")\n","\n","    for images, masks in progress_bar:\n","        images = images.to(device, non_blocking=True)\n","        masks = masks.to(device, non_blocking=True)\n","\n","        with torch.autocast(\n","            device_type=device,\n","            dtype=torch.float16,\n","            enabled=(device == \"cuda\")\n","        ):\n","            logits = model(images)\n","\n","        predictions = (torch.sigmoid(logits) >= threshold).to(torch.uint8)\n","        targets = (masks >= 0.5).to(torch.uint8)\n","\n","        # Micro metrics: aggregate pixels across the whole dataset.\n","        tp += ((predictions == 1) & (targets == 1)).sum().item()\n","        fp += ((predictions == 1) & (targets == 0)).sum().item()\n","        fn += ((predictions == 0) & (targets == 1)).sum().item()\n","        tn += ((predictions == 0) & (targets == 0)).sum().item()\n","\n","        # Macro Dice: calculate one Dice score per image.\n","        batch_dice_sum, num_images = calculate_batch_dice(\n","            logits, masks, threshold=threshold\n","        )\n","        total_dice += batch_dice_sum\n","        total_images += num_images\n","\n","        progress_bar.set_postfix(\n","            macro_dice=f\"{batch_dice_sum / num_images:.4f}\"\n","        )\n","\n","    eps = 1e-7\n","\n","    # Keep these metrics as Micro, matching the original implementation.\n","    precision = tp / (tp + fp + eps)\n","    recall = tp / (tp + fn + eps)\n","    iou = tp / (tp + fp + fn + eps)\n","    accuracy = (tp + tn) / (tp + tn + fp + fn + eps)\n","\n","    # Primary metric: Macro Dice.\n","    macro_dice = total_dice / total_images\n","\n","    results = {\n","        \"Dataset\": dataset_name,\n","        \"Precision_Micro\": precision,\n","        \"Recall_Micro\": recall,\n","        \"Macro_Dice\": macro_dice,\n","        \"IoU_Micro\": iou,\n","        \"Accuracy_Micr