,"source":["@torch.no_grad()\n","def evaluate(model, loader, device, threshold=0.5, dataset_name=\"Test\"):\n","    model.eval()\n","\n","    # Global pixel counts for Micro metrics\n","    tp = 0\n","    fp = 0\n","    fn = 0\n","    tn = 0\n","\n","    # Per-image Dice aggregation for Macro Dice\n","    total_dice = 0.0\n","    total_images = 0\n","\n","    progress_bar = tqdm(loader, desc=f\"Evaluating {dataset_name}\")\n","\n","    for images, masks in progress_bar:\n","        images = images.to(device, non_blocking=True)\n","        masks = masks.to(device, non_blocking=True)\n","\n","        with torch.autocast(\n","            device_type=device,\n","            dtype=torch.float16,\n","            enabled=(device == \"cuda\")\n","        ):\n","            logits = model(images)\n","\n","        predictions = (torch.sigmoid(logits) >= threshold).to(torch.uint8)\n","        targets = (masks >= 0.5).to(torch.uint8)\n","\n","        # Micro metrics: aggregate pixels across the whole dataset.\n","        tp += ((predictions == 1) & (targets == 1)).sum().item()\n","        fp += ((predictions == 1) & (targets == 0)).sum().item()\n","        fn += ((predictions == 0) & (targets == 1)).sum().item()\n","        tn += ((predictions == 0) & (targets == 0)).sum().item()\n","\n","        # Macro Dice: calculate one Dice score per image.\n","        batch_dice_sum, num_images = calculate_batch_dice(\n","            logits, masks, threshold=threshold\n","        )\n","        total_dice += batch_dice_sum\n","        total_images += num_images\n","\n","        progress_bar.set_postfix(\n","            macro_dice=f\"{batch_dice_sum / num_images:.4f}\"\n","        )\n","\n","    eps = 1e-7\n","\n","    # Keep these metrics as Micro, matching the original implementation.\n","    precision = tp / (tp + fp + eps)\n","    recall = tp / (tp + fn + eps)\n","    iou = tp / (tp + fp + fn + eps)\n","    accuracy = (tp + tn) / (tp + tn + fp + fn + eps)\n","\n","    # Primary metric: Macro Dice.\n","    macro_dice = total_dice / total_images\n","\n","    results = {\n","        \"Dataset\": dataset_name,\n","        \"Precision_Micro\": precision,\n","        \"Recall_Micro\": recall,\n","        \"Macro_Dice\": macro_dice,\n","        \"IoU_Micro\": iou,\n","        \"Accuracy_Micro\": accuracy,\n","    }\n","\n","    print(\n","        f\"{dataset_name}: \"\n","        f\"Precision(Micro)={precision:.4f} | \"\n","        f\"Recall(Micro)={recall:.4f} | \"\n","        f\"Macro Dice={macro_dice:.4f} | \"\n","        f\"IoU(Micro)={iou:.4f} | \"\n","        f\"Accuracy(Micro)={accuracy:.4f}\"\n","    )\n","\n","    return results\n"]},{"cell_type":"code","execution_count":23,"id":"fc5bf90d","metadata":{"execution":{"iopub.execute_input":"2026-11-04T12:44:37.511316Z","iopub.status.busy":"2026-11-04T12:44:37.51047Z","iopub.status.idle":"2026-11-04T12:45:40.117161Z","shell.execute_reply":"2026-11-04T12:45:40.115999Z"},"papermill":{"duration":62.996311,"end_time":"2026-11-04T12:45:40.11891+00:00","exception":false,"start_time":"2026-11-04T12:44:37.122599+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Test sample: 500\n"]},{"name":"stderr","output_type":"stream","text":["Evaluating Test: 100%|██████████| 63/63 [00:15<00:00,  4.11it/s, macro_dice=0.3410]\n"]},{"name":"stdout","output_type":"stream","text":["Test: Precision(Micro)=0.6656 | Recall(Micro)=0.5232 | Macro Dice=0.4641 | IoU(Micro)=0.4143 | Accuracy(Micro)=0.9947\n","FCD sample: 500\n"]},{"name":"stderr","output_type":"stream","text":["Evaluating FCD: 100%|██████████| 63/63 [00:33<00:00,  1.87it/s, macro_dice=0.2198]\n"]},{"name":"stdout","output_type":"stream","text":["FCD: Precision(Micro)=0.9468 | Recall(Micro)=0.2467 | Macro Dice=0.3061 | IoU(Micro)=0.2433 | Accuracy(Micro)=0.9721\n","SCD sample: 500\n"]},{"name":"stderr","output_type":"stream","text":["Evaluating SCD: 100%|██████████| 63/63 [00:12<00:00,  4.85it/s, macro_dice=0.3165]"]