ader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=(device == \"cuda\"), persistent_workers=(NUM_WORKERS > 0))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T11:28:52.401285Z","iopub.execute_input":"2026-11-04T11:28:52.401637Z","iopub.status.idle":"2026-11-04T11:28:52.526885Z","shell.execute_reply.started":"2026-11-04T11:28:52.401618Z","shell.execute_reply":"2026-11-04T11:28:52.526039Z"}},"outputs":[],"execution_count":79},{"cell_type":"markdown","source":"# Block 5: Modeling & Hyperparameter","metadata":{"_uuid":"bb35ec37-1329-4895-ac29-8dc4c50b0ae5","_cell_guid":"b58f724c-1e6a-4bab-ba4a-789e00ab87f3","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"class DepthwiseSeparableBlock(nn.Module):\n    \"\"\"Lightweight pointwise + depthwise + pointwise convolution block.\"\"\"\n    def __init__(self, in_channels, out_channels):\n        super().__init__()\n        self.block = nn.Sequential(\n            nn.Conv2d(in_channels, out_channels, kernel_size=1, bias=False),\n            nn.BatchNorm2d(out_channels),\n            nn.ReLU(inplace=True),\n\n            nn.Conv2d(\n                out_channels, out_channels,\n                kernel_size=3, padding=1,\n                groups=out_channels, bias=False\n            ),\n            nn.BatchNorm2d(out_channels),\n            nn.ReLU(inplace=True),\n\n            nn.Conv2d(out_channels, out_channels, kernel_size=1, bias=False),\n            nn.BatchNorm2d(out_channels),\n            nn.ReLU(inplace=True),\n        )\n\n    def forward(self, x):\n        return self.block(x)\n\n\nclass SCSEModule(nn.Module):\n    \"\"\"Concurrent channel and spatial squeeze-excitation.\"\"\"\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        hidden = max(channels // reduction, 4)\n\n        self.channel_attention = nn.Sequential(\n            nn.AdaptiveAvgPool2d(1),\n            nn.Conv2d(channels, hidden, kernel_size=1),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(hidden, channels, kernel_size=1),\n            nn.Sigmoid(),\n        )\n\n        self.spatial_attention = nn.Sequential(\n            nn.Conv2d(channels, 1, kernel_size=1),\n            nn.Sigmoid(),\n        )\n\n    def forward(self, x):\n        channel_features = x * self.channel_attention(x)\n        spatial_features = x * self.spatial_attention(x)\n        return channel_features + spatial_features\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T11:28:52.528Z","iopub.execute_input":"2026-11-04T11:28:52.528315Z","iopub.status.idle":"2026-11-04T11:28:52.536988Z","shell.execute_reply.started":"2026-11-04T11:28:52.528289Z","shell.execute_reply":"2026-11-04T11:28:52.53622Z"}},"outputs":[],"execution_count":80},{"cell_type":"code","source":"class BlockDCT(nn.Module):\n    \"\"\"Orthonormal 8x8 block DCT; output: [B, 64, H/8, W/8].\"\"\"\n    def __init__(self, block_size=8, mean=MEAN, std=STD):\n        super().__init__()\n        self.block_size = block_size\n        self.register_buffer(\"mean\", torch.tensor(mean).view(1, 3, 1, 1))\n        self.register_buffer(\"std\", torch.tensor(std).view(1, 3, 1, 1))\n\n        # Build the orthonormal DCT-II basis.\n        n = block_size\n        basis = torch.empty(n, n, dtype=torch.float32)\n        for u in range(n):\n            alpha = (1.0 / n) ** 0.5 if u == 0 else (2.0 / n) ** 0.5\n            for pos in range(n):\n                basis[u, pos] = alpha * torch.cos(\n                    torch.tensor((2 * pos + 1) * u * torch.pi / (2 * n))\n                )\n        self.register_buffer(\"basis\", basis)\n\n    def forward(self, image):\n        # The input image is ImageNet-normalized. Recover RGB in [0, 1].\n        # Run fixed DCT operations in FP32 for numerical stability under AMP.\n        with torch.autocast(device_type=image.device.type, enabled=False):\n            image = image.float() * self.std + self.mean\n            image = image.clamp(0.0, 1.0)\n\n            gray = (\n                0.299 * image[:, 0:1]\n                + 0.587 * image[:, 1:2]\n                + 0.114 * image[:, 2:3]\n            )\n\n            batch_size, _, height, width = gray.shape\n            n = self.block_size\n            pad_h = (n - height % n) % n\n            pad_w = (n - width % n) % n\n\n            if pad_h or pad_w:\n                gray = F.pad(gray, (0, pad_w, 0, pad_h), mode=\"replicate\")\n\n            # Non-overlapping 8x8 blocks.\n            patches = F.unfold(gray, kernel_size=n, stride=n)\n            grid_h = gray.shape[-2] // n\n            grid_w = gray.shape[-1] // n\n            patches = patches.transpose(1, 2).reshape(\n                batch_size, grid_h * grid_w, n, n\n            )\n\n            basis = self.basis.to(device=image.device, dtype=torch.float32)\n            coeff = torch.matmul(basis, patches)\n            coeff = torch.matmul(coeff, basis.t())\n\n            # [B, number_of_blocks, 8, 8] -> [B, 64, grid_h, grid_w]\n            coeff = coeff.reshape(batch_size, grid_h, grid_w, n, n)\n            coeff = coeff.permute(0, 3, 4, 1, 2).contiguous()\n            coeff = coeff.reshape(batch_size, n * n, grid_h, grid_w)\n\n            # Signed log compression of coefficient range.\n            coeff = torch.sign(coeff) * torch.log1p(torch.abs(coeff) * 8.0)\n\n        return coeff\n\n\nclass LightweightFrequencyHead(nn.Module):\n    \"\"\"Small DCT feature encoder; original JPEG QT embedding is omitted.\"\"\"\n    def __init__(self, out_channels=32):\n        super().__init__()\n        self.block_dct = BlockDCT(block_size=8)\n\n        self.projection = nn.Sequential(\n            nn.Conv2d(64, out_channels, kernel_size=1, bias=False),\n            nn.BatchNorm2d(out_channels),\n            nn.ReLU(inplace=True),\n        )\n        self.refine = DepthwiseSeparableBlock(out_channels, out_channels)\n\n    def forwa