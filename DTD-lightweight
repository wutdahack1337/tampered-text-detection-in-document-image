atial_features\n"]},{"cell_type":"code","execution_count":13,"id":"4657ce55","metadata":{"execution":{"iopub.execute_input":"2026-11-04T12:01:48.393708Z","iopub.status.busy":"2026-11-04T12:01:48.392703Z","iopub.status.idle":"2026-11-04T12:01:48.405883Z","shell.execute_reply":"2026-11-04T12:01:48.405193Z"},"papermill":{"duration":0.030105,"end_time":"2026-11-04T12:01:48.407581+00:00","exception":false,"start_time":"2026-11-04T12:01:48.377476+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class BlockDCT(nn.Module):\n","    \"\"\"Orthonormal 8x8 block DCT; output: [B, 64, H/8, W/8].\"\"\"\n","    def __init__(self, block_size=8, mean=MEAN, std=STD):\n","        super().__init__()\n","        self.block_size = block_size\n","        self.register_buffer(\"mean\", torch.tensor(mean).view(1, 3, 1, 1))\n","        self.register_buffer(\"std\", torch.tensor(std).view(1, 3, 1, 1))\n","\n","        # Build the orthonormal DCT-II basis.\n","        n = block_size\n","        basis = torch.empty(n, n, dtype=torch.float32)\n","        for u in range(n):\n","            alpha = (1.0 / n) ** 0.5 if u == 0 else (2.0 / n) ** 0.5\n","            for pos in range(n):\n","                basis[u, pos] = alpha * torch.cos(\n","                    torch.tensor((2 * pos + 1) * u * torch.pi / (2 * n))\n","                )\n","        self.register_buffer(\"basis\", basis)\n","\n","    def forward(self, image):\n","        # The input image is ImageNet-normalized. Recover RGB in [0, 1].\n","        # Run fixed DCT operations in FP32 for numerical stability under AMP.\n","        with torch.autocast(device_type=image.device.type, enabled=False):\n","            image = image.float() * self.std + self.mean\n","            image = image.clamp(0.0, 1.0)\n","\n","            gray = (\n","                0.299 * image[:, 0:1]\n","                + 0.587 * image[:, 1:2]\n","                + 0.114 * image[:, 2:3]\n","            )\n","\n","            batch_size, _, height, width = gray.shape\n","            n = self.block_size\n","            pad_h = (n - height % n) % n\n","            pad_w = (n - width % n) % n\n","\n","            if pad_h or pad_w:\n","                gray = F.pad(gray, (0, pad_w, 0, pad_h), mode=\"replicate\")\n","\n","            # Non-overlapping 8x8 blocks.\n","            patches = F.unfold(gray, kernel_size=n, stride=n)\n","            grid_h = gray.shape[-2] // n\n","            grid_w = gray.shape[-1] // n\n","            patches = patches.transpose(1, 2).reshape(\n","                batch_size, grid_h * grid_w, n, n\n","            )\n","\n","            basis = self.basis.to(device=image.device, dtype=torch.float32)\n","            coeff = torch.matmul(basis, patches)\n","            coeff = torch.matmul(coeff, basis.t())\n","\n","            # [B, number_of_blocks, 8, 8] -> [B, 64, grid_h, grid_w]\n","            coeff = coeff.reshape(batch_size, grid_h, grid_w, n, n)\n","            coeff = coeff.permute(0, 3, 4, 1, 2).contiguous()\n","            coeff = coeff.reshape(batch_size, n * n, grid_h, grid_w)\n","\n","            # Signed log compression of coefficient range.\n","            coeff = torch.sign(coeff) * torch.log1p(torch.abs(coeff) * 8.0)\n","\n","        return coeff\n","\n","\n","class LightweightFrequencyHead(nn.Module):\n","    \"\"\"Small DCT feature encoder; original JPEG QT embedding is omitted.\"\"\"\n","    def __init__(self, out_channels=32):\n","        super().__init__()\n","        self.block_dct = BlockDCT(block_size=8)\n","\n","        self.projection = nn.Sequential(\n","            nn.Conv2d(64, out_channels, kernel_size=1, bias=False),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","        )\n","        self.refine = DepthwiseSeparableBlock(out_channels, out_channels)\n","\n","    def forward(self, image):\n","        dct_map = self.block_dct(image)\n","        features = self.projection(dct_map)\n","        return self.refine(features)\