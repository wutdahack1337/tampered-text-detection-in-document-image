ew, H/32.\n","        d32 = self.decode_32(f32)\n","\n","        # Iteration 2: H/16 combines its own feature and H/32 context.\n","        d16 = self.decode_16(torch.cat([\n","            f16,\n","            self.upsample_to(d32, f16),\n","        ], dim=1))\n","\n","        # Iteration 3: H/8 combines H/8, H/16 and H/32 features.\n","        d8 = self.decode_8(torch.cat([\n","            f8,\n","            self.upsample_to(d16, f8),\n","            self.upsample_to(d32, f8),\n","        ], dim=1))\n","\n","        # Iteration 4: H/4 combines all coarser views.\n","        d4 = self.decode_4(torch.cat([\n","            f4,\n","            self.upsample_to(d8, f4),\n","            self.upsample_to(d16, f4),\n","            self.upsample_to(d32, f4),\n","        ], dim=1))\n","\n","        # Final multi-view aggregation at H/4.\n","        multi_view = torch.cat([\n","            d4,\n","            self.upsample_to(d8, d4),\n","            self.upsample_to(d16, d4),\n","            self.upsample_to(d32, d4),\n","        ], dim=1)\n","\n","        logits = self.segmentation_head(self.project(multi_view))\n","        return F.interpolate(\n","            logits, size=output_size, mode=\"bilinear\", align_corners=False\n","        )\n","\n","\n","class LightweightDTD(nn.Module):\n","    \"\"\"DTD-inspired lightweight model: MobileNetV3 + block-DCT FPH + LiteMID.\n","\n","    This is not an exact reproduction of CVPR 2023 DTD. The current LMDB\n","    pipeline supplies decoded images but not the original JPEG quantization\n","    tables, so the original FPH quantization-table embedding is not included.\n","    \"\"\"\n","    def __init__(\n","        self,\n","        pretrained=True,\n","        out_channels=1,\n","        frequency_channels=32,\n","        decoder_width=64,\n","    ):\n","        super().__init__()\n","\n","        weights = MobileNet_V3_Large_Weights.DEFAULT if pretrained else None\n","        backbone = mobilenet_v3_large(weights=weights)\n","        self.encoder = backbone.features\n","\n","        self.frequency_head = LightweightFrequencyHead(\n","            out_channels=frequency_channels\n","        )\n","\n","        # DTD-inspired early fusion: scSE + 1x1 channel projection.\n","        self.fusion_attention = SCSEModule(40 + frequency_channels, reduction=8)\n","        self.fusion_projection = nn.Sequential(\n","            nn.Conv2d(40 + frequency_channels, 40, kernel_size=1, bias=False),\n","            nn.BatchNorm2d(40),\n","            nn.ReLU(inplace=True),\n","        )\n","\n","        self.decoder = LiteMID(\n","            channels=(24, 40, 112, 960),\n","            width=decoder_width,\n","            out_channels=out_channels,\n","        )\n","\n","    def forward(self, x):\n","        input_size = x.shape[-2:]\n","\n","        # MobileNetV3-Large feature maps:\n","        # f4: 24 channels at H/4\n","        # f8: 40 channels at H/8\n","        # f16: 112 channels at H/16\n","        # f32: 960 channels at H/32\n","        f2 = self.encoder[1](self.encoder[0](x))\n","        f4 = self.encoder[3](self.encoder[2](f2))\n","        f8 = self.encoder[6](self.encoder[5](self.encoder[4](f4)))\n","\n","        f16 = f8\n","        for idx in range(7, 13):\n","            f16 = self.encoder[idx](f16)\n","\n","        f32 = f16\n","        # Torchvision MobileNetV3-Large has features indexed 0..16.\n","        # The range includes indices 13, 14, 15 and 16; index 16 outputs 960 channels.\n","        for idx in range(13, 17):\n","            f32 = self.encoder[idx](f32)\n","\n","        # DCT blocks naturally produce an H/8 x W/8 feature grid.\n","        frequency_features = self.frequency_head(x)\n","        if frequency_features.shape[-2:] != f8.shape[-2:]:\n","            frequency_features = F.interpolate(\n","                frequency_features,\n","                size=f8.shape[-2:],\n","                mode=\"bilinear\",\n","                align_corners=False,\n","            )\n","\n","        fused = torch.cat([f8, frequency_features], dim=1)\n","        fused = self.fusion_attention(fused)\n","        fused = self.fusion_projection(fused)\n","\n","        return self.decoder(f4, fused, f16, f32, input_size)\n","\n","\n","model = LightweightDTD(\n","    pretrained=True,\n","    out_channels=1,\n","    frequency_channels=32,\n","    decoder_width=64,\n",").to(device)\n"]},{"cell_type":"code","execution_count":15,"id":"8c905d47","metadata":{"execution":{"iopub.execute_input":"2026-11-04T12:01:49.533677Z","iopub.status.busy":"2026-11-04T12:01:49.533185Z","iopub.status.idle":"2026-11-04T12:01:51.218249Z","shell.execute_reply":"2026-11-04T12:01:51.217162Z"},"papermill":{"duration":1.703209,"end_time":"2026-11-04T12:01:51.220016+00:00","exception":false,"start_time":"2026-11-04T12:01:49.516807+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Input: torch.Size([2, 3, 224, 224])\n","Output: torch.Size([2, 1, 224, 224])\n","Total parameters: 3,124,235\n","Trainable parameters: 3,124,235\n"]}],"source":["model.eval()\n","\n","with torch.no_grad():\n","    dummy = torch.randn(2, 3, 224, 224).to(device)\n","    output = model(dummy)\n","\n","print(\"Input:\", dummy.shape)\n","print(\"Output:\", output.shape)\n","print(\"Total parameters:\", f\"{sum(p.numel() for p in model.parameters()):,}\")\n","print(\"Trainable parameters:\", f\"{sum(p.numel() for p in model.parameters() if p.requires_grad):,}\")\n","\n","assert output.shape == (2, 1, 224, 224)\n"]},{"cell_type":"code","execution_count":16,"id":"30713908","metadata":{"execution":{"iopub.execute_input":"2026-11-04T12:01:51.251347Z","iopub.status.busy":"2026-11-04T12:01:51.250477Z","iopub.status.idle":"2026-11-04T12:01:51.260075Z","shell.execute_reply":"2026-11-04T12:01:51.259336Z"},"papermill":{"duration":0.027319,"end_time":"2026-11-04T12:01:51.26165+00:00","exception":false,"start_time":"2026-11-04T12:01:51.234331+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class BCEDiceLoss(nn.Module):\n","    def __init__(self, dice_weight=1.0, smooth=1.0):\n","        super().__init__()\n","        self.bce = nn.BCEWithLogitsLoss()\n","        self.dice_weight = dice_weight\n","        self.smooth = smooth\n","\n","    def forward(self, logits, targets):\n","        logits = logits.float()  # compute the loss in fp32 even under autocast\n","        bce = self.bce(logits, targets)\n","        probs = torch.sigmoid(logits)\n","        inter = (probs * targets).sum()\n","        dice = (2.0 * inter + self.smooth) / (probs.sum() + targets.sum() + self.smooth)\n","        return bce + self.dice_weight * (1.0 - dice)\n","\n","criterion = BCEDiceLoss()\n","\n","encoder_params = list(model.encoder.parameters())\n","decoder_params = [\n","    param\n","    for name, param in model.named_parameters()\n","    if not name.startswith(\"encoder.\")\n","]\n","optimizer = torch.optim.AdamW([\n","    {\"params\": encoder_params, \"lr\": ENCODER_LR},\n","    {\"params\": decoder_params, \"lr\": DECODER_LR},\n","], weight_decay=WD)\n","\n","scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)\n","scaler = torch.amp.GradScaler(\"cuda\", enabled=(device == \"cuda\"))"]},{"cell_type":"markdown","id":"c2ece838","metadata":{"_cell_guid":"56787786-2ae8-4992-9aae-ae58ea986610","_uuid":"fec4e592-f721-4fc1-9600-ba2afea738f7","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.014021,"end_time":"2026-11-04T12:01:51.289868+00:00","exception":false,"start_time":"2026-11-04T12:01:51.275847+00:00","status":"completed"},"tags":[]},"source":["# Block 6: Training & Validation Loop"]},{"cell_type":"code","execution_count":17,"id":"fbc87946","metadata":{"execution":{"iopub.execute_input":"2026-11-04T12:01:51.319216Z","iopub.status.busy":"2026-11-04T12:01:51.31887Z","iopub.status.idle":"2026-11-04T12:01:51.324585Z","shell.execute_reply":"2026-11-04T12:01:51.32391Z"},"papermill":{"duration":0.02