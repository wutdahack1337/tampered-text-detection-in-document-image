duler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)\nscaler = torch.amp.GradScaler(\"cuda\", enabled=(device == \"cuda\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T11:28:52.913923Z","iopub.execute_input":"2026-11-04T11:28:52.914455Z","iopub.status.idle":"2026-11-04T11:28:52.931031Z","shell.execute_reply.started":"2026-11-04T11:28:52.914425Z","shell.execute_reply":"2026-11-04T11:28:52.930243Z"}},"outputs":[],"execution_count":84},{"cell_type":"markdown","source":"# Block 6: Training & Validation Loop","metadata":{"_uuid":"fec4e592-f721-4fc1-9600-ba2afea738f7","_cell_guid":"56787786-2ae8-4992-9aae-ae58ea986610","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def calculate_batch_dice(logits, masks, threshold=0.5, smooth=1e-6):\n    predictions = (torch.sigmoid(logits) >= threshold).float()\n    targets = (masks >= 0.5).float()\n\n    predictions = predictions.flatten(start_dim=1)\n    targets = targets.flatten(start_dim=1)\n\n    intersection = (predictions * targets).sum(dim=1)\n    pred_sum = predictions.sum(dim=1)\n    target_sum = targets.sum(dim=1)\n\n    dice = (2.0 * intersection + smooth) / (\n        pred_sum + target_sum + smooth\n    )\n\n    return dice.sum().item(), dice.numel()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T11:28:52.932406Z","iopub.execute_input":"2026-11-04T11:28:52.932685Z","iopub.status.idle":"2026-11-04T11:28:52.940644Z","shell.execute_reply.started":"2026-11-04T11:28:52.932656Z","shell.execute_reply":"2026-11-04T11:28:52.939925Z"}},"outputs":[],"execution_count":85},{"cell_type":"code","source":"@torch.no_grad()\ndef validate_one_epoch(model, loader, criterion):\n    model.eval()\n\n    running_loss = 0.0\n    total_dice = 0.0\n    total_images = 0\n\n    progress_bar = tqdm(loader, desc=\"Validation\")\n\n    for images, masks in progress_bar:\n        images = images.to(device, non_blocking=True)\n        masks = masks.to(device, non_blocking=True)\n\n        with torch.autocast(device_type=device, dtype=torch.float16, enabled=(device == \"cuda\")):\n            logits = model(images)\n            loss = criterion(logits, masks)\n\n        batch_size = images.size(0)\n        batch_dice_sum, num_images = calculate_batch_dice(logits, masks)\n\n        running_loss += loss.item() * batch_size\n        total_dice += batch_dice_sum\n        total_images += num_images\n\n        progress_bar.set_postfix(\n            loss=f\"{loss.item():.4f}\",\n            macro_dice=f\"{batch_dice_sum / num_images:.4f}\"\n        )\n\n    avg_loss = running_loss / len(loader.dataset)\n    avg_macro_dice = total_dice / total_images\n\n    return avg_loss, avg_macro_dice\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T11:28:52.941637Z","iopub.execute_input":"2026-11-04T11:28:52.942014Z","iopub.status.idle":"2026-11-04T11:28:52.955762Z","shell.execute_reply.started":"2026-11-04T11:28:52.941985Z","shell.execute_reply":"2026-11-04T11:28:52.954963Z"}},"outputs":[],"execution_count":86},{"cell_type":"code","source":"def train_one_epoch(model, loader, criterion, optimizer, scaler):\n    model.train()\n    running_loss = 0.0\n\n    progress_bar = tqdm(loader, desc=\"Train\")\n\n    for images, masks in progress_bar:\n        images = images.to(device, non_blocking=True)\n        masks = masks.to(device, non_blocking=True)\n\n        optimizer.zero_grad(set_to_none=True)\n\n        with torch.autocast(device_type=device, dtype=torch.float16, enabled=(device == \"cuda\")):\n            logits = model(images)\n            loss = criterion(logits, masks)\n\n        scaler.scale(loss).backward()\n        scaler.step(optimizer)\n        scaler.update()\n\n        batch_size = images.size(0)\n        running_loss += loss.item() * batch_size\n\n        progress_bar.set_postfix(loss=f\"{loss.item():.4f}\")\n\n    return running_loss / len(loader.dataset)","metadata":{"