ory=(device == \"cuda\"), persistent_workers=(NUM_WORKERS > 0))\n","val_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=(device == \"cuda\"), persistent_workers=(NUM_WORKERS > 0))"]},{"cell_type":"markdown","id":"b572a0e3","metadata":{"_cell_guid":"b58f724c-1e6a-4bab-ba4a-789e00ab87f3","_uuid":"bb35ec37-1329-4895-ac29-8dc4c50b0ae5","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.013618,"end_time":"2026-11-04T16:29:28.752248+00:00","exception":false,"start_time":"2026-11-04T16:29:28.73863+00:00","status":"completed"},"tags":[]},"source":["# Block 5: Modeling & Hyperparameter"]},{"cell_type":"code","execution_count":7,"id":"320eb27d","metadata":{"execution":{"iopub.execute_input":"2026-11-04T16:29:28.7824Z","iopub.status.busy":"2026-11-04T16:29:28.781533Z","iopub.status.idle":"2026-11-04T16:29:28.789793Z","shell.execute_reply":"2026-11-04T16:29:28.789222Z"},"papermill":{"duration":0.024553,"end_time":"2026-11-04T16:29:28.791346+00:00","exception":false,"start_time":"2026-11-04T16:29:28.766793+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class DepthwiseSeparableBlock(nn.Module):\n","    \"\"\"Lightweight pointwise + depthwise + pointwise convolution block.\"\"\"\n","    def __init__(self, in_channels, out_channels):\n","        super().__init__()\n","        self.block = nn.Sequential(\n","            nn.Conv2d(in_channels, out_channels, kernel_size=1, bias=False),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","\n","            nn.Conv2d(\n","                out_channels, out_channels,\n","                kernel_size=3, padding=1,\n","                groups=out_channels, bias=False\n","            ),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","\n","            nn.Conv2d(out_channels, out_channels, kernel_size=1, bias=False),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","        )\n","\n","    def forward(self, x):\n","        return self.block(x)\n","\n","\n","class SCSEModule(nn.Module):\n","    \"\"\"Concurrent channel and spatial squeeze-excitation.\"\"\"\n","    def __init__(self, channels, reduction=8):\n","        super().__init__()\n","        hidden = max(channels // reduction, 4)\n","\n","        self.channel_attention = nn.Sequential(\n","            nn.AdaptiveAvgPool2d(1),\n","            nn.Conv2d(channels, hidden, kernel_size=1),\n","            nn.ReLU(inplace=True),\n","            nn.Conv2d(hidden, channels, kernel_size=1),\n","            nn.Sigmoid(),\n","        )\n","\n","        self.spatial_attention = nn.Sequential(\n","            nn.Conv2d(channels, 1, kernel_size=1),\n","            nn.Sigmoid(),\n","        )\n","\n","    def forward(self, x):\n","        channel_features = x * self.channel_attention(x)\n","        spatial_features = x * self.spatial_attention(x)\n","        return channel_features + spatial_features\n"]},{"cell_type":"code","execution_count":8,"id":"a8dbdfd1","metadata":{"execution":{"iopub.execute_input":"2026-11-04T16:29:28.819679Z","iopub.status.busy":"2026-11-04T16:29:28.819467Z","iopub.status.idle":"2026-11-04T16:29:28.832563Z","shell.execute_reply":"2026-11-04T16:29:28.831719Z"},"papermill":{"duration":0.029135,"end_time":"2026-11-04T16:29:28.834217+00:00","exception":false,"start_time":"2026-11-04T16:29:28.805082+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class BlockDCT(nn.Module):\n","    \"\"\"Orthonormal 8x8 block DCT; output: [B, 64, H/8, W/8].\"\"\"\n","    def __init__(self, block_size=8, mean=MEAN, std=STD):\n","        super().__init__()\n","        self.block_size = block_size\n","        self.register_buffer(\"mean\", torch.tensor(mean).view(1, 3, 1, 1))\n","        self.register_buffer(\"std\", torch.tensor(std).view(1, 3, 1, 1))\n","\n","        # Build the orthonormal DCT-II basis.\n","        n = block_size\n","        basis = torch.empty(n, n, dtype=torch.float32)\n","        for u in range(n):\n","            alpha = (1.0 / n) ** 0.5 if u == 0 else (2.0 / n) ** 0.5\n","            for pos in range(n):\n","                basis[u, pos] = alpha * torch.cos(\n","                    torch.tensor((2 * pos + 1) * u * torch.pi / (2 * n))\n","                )\n","        self.register_buffer(\"basis\", basis)\n","\n","    def forward(self, image):\n","        # The input image is ImageNet-normalized. Recover RGB in [0, 1].\n","        # Run fixed DCT operations in FP32 for numerical stability under AMP.\n","        with torch.autocast(device_type=image.device.type, enabled=False):\n","            image = image.float() * self.std + self.mean\n","            image = image.clamp(0.0, 1.0)\n","\n","            gray = (\n","                0.299 * image[:, 0:1]\n","                + 0.587 * image[:, 1:2]\n","                + 0.114 * image[:, 2:3]\n","            )\n","\n","            batch_size, _, height, width = gray.shape\n","            n = self.block_size\n","            pad_h = (n - height % n) % n\n","            pad_w = (n - width % n) % n\n","\n","            if pad_h or pad_w:\n","                gray = F.pad(gray, (0, pad_w, 0, pad_h), mode=\"replicate\")\n","\n","            # Non-overlapping 8x8 blocks.\n","            patches = F.unfold(gray, kernel_size=n, stride=n)\n","            grid_h = gray.shape[-2] // n\n","            grid_w = gray.shape[-1] // n\n","            patches = patches.transpose(1, 2).reshape(\n","                batch_size, grid_h * grid_w, n, n\n","            )\n","\n","            basis = self.basis.to(device=image.device, dtype=torch.float32)\n","            coeff = torch.matmul(basis, patches)\n","            coeff = torch.matmul(coeff, basis.t())\n","\n","            # [B, number_of_blocks, 8, 8] -> [B, 64, grid_h, grid_w]\n","            coeff = coeff.reshape(batch_size, grid_h, grid_w, n, n)\n","            coeff = coeff.permute(0, 3, 4, 1, 2).contiguous()\n","            coeff = coeff.reshape(batch_size, n * n, grid_h, grid_w)\n","\n","            # Signed log compression of coefficient range.\n","            coeff = torch.sign(coeff) * torch.log1p(torch.abs(coeff) * 8.0)\n","\n","        return coeff\n","\n","\n","class LightweightFrequencyHead(nn.Module):\n","    \"\"\"Small DCT feature encoder; original JPEG QT embedding is omitted.\"\"\"\n","    def __init__(self, out_channels=32):\n","        super().__init__()\n","        self.block_dct = BlockDCT(block_size=8)\n","\n","        self.projection = nn.Sequential(\n","            nn.Conv2d(64, out_channels, kernel_size=1, bias=False),\n","            nn.BatchNorm2d(out_channels),\n","            nn.ReLU(inplace=True),\n","        )\n","        self.refine = DepthwiseSeparableBlock(out_channels, out_channels)\n","\n","    def forward(self, image):\n","        dct_map = self.block_dct(image)\n","        features = self.projection(dct_map)\n","        return self.refine(features)\n"]},{"cell_type":"code","execution_count":9,"id":"78f701d6","metadata":{"execution":{"iopub.execute_input":"2026-11-04T16:29:28.862601Z","iopub.status.busy":"2026-11-04T16:29:28.862321Z","iopub.status.idle":"2026-11-04T16:29:29.851068Z","shell.execute_reply":"2026-11-04T16:29:29.850428Z"},"papermill":{"duration":1.004704,"end_time":"2026-11-04T16:29:29.85292+00:00","exception":false,"start_time":"2026-11-04T16:29:28.848216+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Downloading: \"https://download.pytorch.org/models/efficientnet_b0_rwightman-7f5810bc.pth\" to /root/.cache/torch/hub/checkpoints/efficientnet_b0_rwightman-7f5810bc.pth\n"]},{"name":"stderr","output_type":"stream","text":["100%|██████████| 20.5M/20.5M [00:00<00:00, 203MB/s]\n"]}],"source":["class LiteMID(nn.Module):\n","    \"\"\"\n","    Lightweight approximation of DTD's Multi-view Iterative Decoder.\n","\n","    Inputs are ordered from high to low spatial resolution:\n","      f0: [B, 24,   H/4,  W/4]\n","      f1: [B, 40,   H/8,  W/8]   (already fused with DCT features)\n","      f2: [B, 112,  H/16, W/16]\n","      f3: [B, 1280, H/32, W/32]\n","\n","    The decoder builds a small nested decoding grid:\n","      first view:  x00, x11, x22\n","      second view: x01, x12\n","      final view:  x02\n","\n","    This preserves the iterative multi-scale aggregation idea while\n","    using depthwise-separable convolutions to reduce compute.\n","    \"\"\"\n","    def __init__(self, in_channels=(24, 40, 112, 1280), width=48):\n","        super().__init__()\n","\n","        self.projections = nn.ModuleList([\n","            nn.Sequential(\n","                nn.Conv2d(ch, width, kernel_size=1, bias=False),\n","                nn.BatchNorm2d(width),\n","                nn.ReLU(inplace=True),\n","            )\n","            for ch in in_channels\n","        ])\n","\n","        # View 1: adjacent-scale decoding.\n","        self.x00 = DepthwiseSeparableBlock(width * 2, width)\n","        self.x11 = DepthwiseSeparableBlock(width * 2, width)\n","        self.x22 = DepthwiseSeparableBlock(width * 2, width)\n","\n","        # View 2: aggregate the previous view and encoder skip features.\n","        self.x01 = DepthwiseSeparableBlock(width * 3, width)\n","        self.x12 = DepthwiseSeparableBlock(width * 3, width)\n","\n","        # View 3: final iterative aggregation at H/4.\n","        self.x02 = DepthwiseSeparableBlock(width * 4, width)\n","\n","        self.refine = SCSEModule(width)\n","\n","    @staticmethod\n","    def upsample_to(x, reference):\n","        return F.interpolate(\n","            x,\n","            size=reference.shape[-2:],\n","            mode=\"bilinear\",\n","            align_corners=False,\n","        )\n","\n","    def forward(self, f0, f1, f2, f3):\n","        # Project all encoder scales to a compact common channel width.\n","        p0, p1, p2, p3 = [\n","            projection(feature)\n","            for projection, feature in zip(\n","                self.projections, (f0, f1, f2, f3)\n","            )\n","        ]\n","\n","        # View 1: coarse-to-fine decoding on adjacent scales.\n","        x00 = self.x00(torch.cat([\n","            self.upsample_to(p3, p2), p2\n","        ], dim=1))\n","\n","        x11 = self.x11(torch.cat([\n","            self.upsample_to(p2, p1), p1\n","        ], dim=1))\n","\n","        x22 = self.x22(torch.cat([\n","            self.upsample_to(p1, p0), p0\n","        ], dim=1))\n","\n","        # View 2: iterative fusion of decoder outputs and encoder features.\n","        x01 = self.x01(torch.cat([\n","            self.upsample_to(x00, x11),\n","            x11,\n","            p1,\n","        ], dim=1))\n","\n","        x12 = self.x12(torch.cat([\n","            self.upsample_to(x11, x22),\n","            x22,\n","            p0,\n","        ], dim=1))\n","\n","        # View 3: final multi-view aggregation at 1/4 resolution.\n","        x02 = self.x02(torch.cat([\n","            self.upsample_to(x01, x22),\n","            x12,\n","            x22,\n","            p0,\n","        ], dim=1))\n","\n","        return self.refine(x02)\n","\n","\n","class LightweightDTD(nn.Module):\n","    \"\"\"\n","    DTD-inspired lightweight model:\n","      - Spatial branch: EfficientNet-B0\n","      - Frequency branch: block-wise 8x8 DCT\n","      - Fusion: scSE + 1x1 projection at 1/8 resolution\n","      - Decoder: LiteMID (nested multi-view iterative decoder)\n","\n","    This is not a reproduction of the original DTD MID. It is a\n","    compute-conscious approximation of its multi-view iterative idea.\n","    \"\"\"\n","    def __init__(\n","        self,\n","        pretrained=True,\n","        out_channels=1,\n","        frequency_channels=32,\n","        decoder_width=48,\n","    ):\n","        super().__init__()\n","\n","        weights = EfficientNet_B0_Weights.DEFAULT if pretrained else None\n","        backbone = efficientnet_b0(weights=weights)\n","        self.encoder = backbone.features\n","\n","        self.frequency_branch = LightweightFrequencyHead(\n","            out_channels=frequency_channels\n","        )\n","\n","        self.frequency_fusion = nn.Sequential(\n","            SCSEModule(40 + frequency_channels),\n","            nn.Conv2d(\n","                40 + frequency_channels,\n","                40,\n","                kernel_size=1,\n","                bias=False,\n","            ),\n","            nn.BatchNorm2d(40),\n","            nn.ReLU(inplace=True),\n","        )\n","\n","        self.decoder = LiteMID(\n","            in_channels=(24, 40, 112, 1280),\n","            width=decoder_width,\n","        )\n","\n","        self.segmentation_head = nn.Conv2d(\n","            decoder_width,\n","            out_channels,\n","            kernel_size=1,\n","        )\n","\n","    def forward(self, x):\n","        input_size = x.shape[-2:]\n","\n","        # EfficientNet-B0 feature taps:\n","        # features[2]: 24 channels, stride 4\n","        # features[3]: 40 channels, stride 8\n","        # features[5]: 112 channels, stride 16\n","        # features[8]: 1280 channels, stride 32\n","        z = x\n","        f0 = f1 = f2 = f3 = None\n","\n","        for idx, layer in enumerate(self.encoder):\n","            z = layer(z)\n","\n","            if idx == 2:\n","                f0 = z\n","            elif idx == 3:\n","                f1 = z\n","            elif idx == 5:\n","                f2 = z\n","            elif idx == 8:\n","                f3 = z\n","\n","        # DCT frequency features are fused at the 1/8 scale.\n","        freq = self.frequency_branch(x)\n","\n","        if freq.shape[-2:] != f1.shape[-2:]:\n","            freq = F.interpolate(\n","                freq,\n","                size=f1.shape[-2:],\n","                mode=\"bilinear\",\n","                align_corners=False,\n","            )\n","\n","        f1 = self.frequency_fusion(