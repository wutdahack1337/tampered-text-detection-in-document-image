      "\u001b[36mFile \u001b[39m\u001b[32m/opt/conda/lib/python3.11/site-packages/torch/autograd/graph.py:1072\u001b[39m, in \u001b[36m_engine_run_backward\u001b[39m\u001b[34m(t_outputs, *args, **kwargs)\u001b[39m\n\u001b[32m   1069\u001b[39m torch._C._stash_obj_in_tls(\u001b[33m\"\u001b[39m\u001b[33mcontext\u001b[39m\u001b[33m\"\u001b[39m, contextvars.copy_context())\n\u001b[32m   1071\u001b[39m \u001b[38;5;28;01mtry\u001b[39;00m:\n\u001b[32m-> \u001b[39m\u001b[32m1072\u001b[39m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43mVariable\u001b[49m\u001b[43m.\u001b[49m\u001b[43m_execution_engine\u001b[49m\u001b[43m.\u001b[49m\u001b[43mrun_backward\u001b[49m\u001b[43m(\u001b[49m\u001b[43m  \u001b[49m\u001b[38;5;66;43;03m# Calls into the C++ engine to run the backward pass\u001b[39;49;00m\n\u001b[32m   1073\u001b[39m \u001b[43m        \u001b[49m\u001b[43mt_outputs\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m*\u001b[49m\u001b[43margs\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43m*\u001b[49m\u001b[43m*\u001b[49m\u001b[43mkwargs\u001b[49m\n\u001b[32m   1074\u001b[39m \u001b[43m    \u001b[49m\u001b[43m)\u001b[49m  \u001b[38;5;66;03m# Calls into the C++ engine to run the backward pass\u001b[39;00m\n\u001b[32m   1075\u001b[39m \u001b[38;5;28;01mfinally\u001b[39;00m:\n\u001b[32m   1076\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m attach_logging_hooks:\n",
      "\u001b[31mKeyboardInterrupt\u001b[39m: "
     ]
    }
   ],
   "source": [
    "best_val_dice = -1.0\n",
    "for epoch in range(EPOCHS):\n",
    "    print(\"epoch: \", epoch)\n",
    "    \n",
    "    train_loss = train_one_epoch(model, train_loader, criterion, optimizer, scaler)\n",
    "    print(\"train_loss: \", train_loss)\n",
    "\n",
    "    val_loss, val_dice = validate_one_epoch(model, val_loader, criterion)\n",
    "    print(\"val_loss: \", val_loss)\n",
    "    print(\"val_dice: \", val_dice)\n",
    "    \n",
    "    scheduler.step()\n",
    "\n",
    "    if val_dice > best_val_dice:\n",
    "        best_val_dice = val_dice\n",
    "        torch.save({\n",
    "            \"epoch\": epoch+1,\n",
    "            \"model_state_dict\": model.state_dict(),\n",
    "            \"optimizer_state_dict\": optimizer.state_dict(),\n",
    "            \"scheduler_state_dict\": scheduler.state_dict(),\n",
    "            \"scaler_state_dict\": scaler.state_dict(),\n",
    "            \"best_val_dice\": best_val_dice,\n",
    "        }, BEST_MODEL_PATH)\n",
    "        print(f\"Saved new best model (Val dice: {best_val_dice:.4f})\")\n",
    "\n",
    "\n",
    "print(f\"Training completed. Best Val Dice: {best_val_dice:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5538b212-efd6-4e32-821a-a3d015450e02",
   "metadata": {},
   "source": [
    "# Block 7: Inference"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "9f0e701b-1c36-4d86-bd6d-bac4a3392486",
   "metadata": {},
   "outputs": [],
   "source": [
    "checkpoint = torch.load(BEST_MODEL_PATH, map_location=device)\n",
    "model.load_state_dict(checkpoint[\"model_state_dict\"])\n",
    "\n",
    "model.eval();"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "2bb333fb-53c6-4ee3-8812-26904d204bc5",
   "metadata": {},
   "outputs": [],
   "source": [
    "@torch.no_grad()\n",
    "def evaluate(model, loader, device, threshold=0.5, dataset_name=\"Test\"):\n",
    "    model.eval()\n",
    "\n",
    "    # Global pixel counts for Micro metrics\n",
    "    tp = 0\n",
    "    fp = 0\n",
    "    fn = 0\n",
    "    tn = 0\n",
    "\n",
    "    # Per-image Dice aggregation for Macro Dice\n",
    "    total_dice = 0.0\n",
    "    total_images = 0\n",
    "\n",
    "    progress_bar = tqdm(loader, desc=f\"Evaluating {dataset_name}\")\n",
    "\n",
    "    for images, masks in progress_bar:\n",
    "        images = images.to(device, non_blocking=True)\n",
    "        masks = masks.to(device, non_blocking=True)\n",
    "\n",
    "        with torch.autocast(\n",
    "            device_type=device,\n",
    "            dtype=torch.float16,\n",
    "            enabled=(device == \"cuda\")\n",
    "        ):\n",
    "            logits = model(images)\n",
    "\n",
    "        predictions = (torch.sigmoid(logits) >= threshold).to(torch.uint8)\n",
    "        targets = (masks >= 0.5).to(torch.uint8)\n",
    "\n",
    "        # Micro metrics: aggregate pixels across the whole dataset.\n",
    "        tp += ((predictions == 1) & (targets == 1)).sum().item()\n",
    "        fp += ((predictions == 1) & (targets == 0)).sum().item()\n",
    "        fn += ((predictions == 0) & (targets == 1)).sum().item()\n",
    "        tn += ((predictions == 0) & (targets == 0)).sum().item()\n",
    "\n",
    "        # Macro Dice: calculate one Dice score per image.\n",
    "        batch_dice_sum, num_images = calculate_batch_dice(\n",
    "            logits, masks, threshold=threshold\n",
    "        )\n",
    "        total_dice += batch_dice_sum\n",
    "        total_images += num_images\n",
    "\n",
    "        progress_bar.set_postfix(\n",
    "            macro_dice=f\"{batch_dice_sum / num_images:.4f}\"\n",
    "        )\n",
    "\n",
    "    eps = 1e-7\n",
    "\n",
    "    # Keep these metrics as Micro, matching the original implementation.\n",
    "    precision = tp / (tp + fp + eps)\n",
    "    recall = tp / (tp + fn + eps)\n",
    "    iou = tp / (tp + fp + fn + eps)\n",
    "    accuracy = (tp + tn) / (tp + tn + fp + fn + eps)\n",
    "\n",
    "    # Primary metric: Macro Dice.\n",
    "    macro_dice = total_dice / total_images\n",
    "\n",
    "    results = {\n",
    "        \"Dataset\": dataset_name,\n",
    "        \"Precision_Micro\": precision,\n",
    "        \"Recall_Micro\": recall,\n",
    "        \"Macro_Dice\": macro_dice,\n",
    "        \"IoU_Micro\": iou,\n",
    "        \"Accuracy_Micro\": accuracy,\n",
    "    }\n",
    "\n",
    "    print(\n",
    "        f\"{dataset_name}: \"\n",
    "        f\"Precision(Micro)={precision:.4f} | \"\n",
    "        f\"Recall(Micro)={recall:.4f} | \"\n",
    "        f\"Macro Dice={macro_dice:.4f} | \"\n",
    "        f\"IoU(Micro)={iou:.4f} | \"\n",
    "        f\"Accuracy(Micro)={accuracy:.4f}\"\n",
    "    )\n",
    "\n",
    "    return results\n"
   ]
  },
  {
