   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "VLM model: Qwen/Qwen3-VL-4B-Instruct\n",
      "VLM output directory: /workspace/vlm_reports\n"
     ]
    }
   ],
   "source": [
    "# VLM configuration\n",
    "from pathlib import Path\n",
    "import os\n",
    "import gc\n",
    "import json\n",
    "import cv2\n",
    "import numpy as np\n",
    "import torch\n",
    "from PIL import Image, ImageDraw\n",
    "\n",
    "VLM_MODEL_ID = \"Qwen/Qwen3-VL-4B-Instruct\"\n",
    "VLM_SAMPLE_SPLIT = \"DocTamperV1-TestingSet\"  # or DocTamperV1-FCD / DocTamperV1-SCD\n",
    "VLM_SAMPLE_INDEX = 0\n",
    "VLM_THRESHOLD = 0.5\n",
    "VLM_MAX_REGIONS = 2\n",
    "VLM_MIN_COMPONENT_AREA = 12\n",
    "VLM_CROP_MARGIN = 12\n",
    "VLM_MAX_NEW_TOKENS = 320\n",
    "\n",
    "# Keep the VLM context modest for a single-GPU workstation.\n",
    "VLLM_GPU_MEMORY_UTILIZATION = 0.75\n",
    "VLLM_MAX_MODEL_LEN = 8192\n",
    "VLLM_MAX_NUM_SEQS = 1\n",
    "VLLM_MAX_IMAGES_PER_PROMPT = 1 + 1 + VLM_MAX_REGIONS  # original + overlay + crops\n",
    "\n",
    "VLM_OUTPUT_DIR = Path.cwd() / \"vlm_reports\"\n",
    "VLM_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(\"VLM model:\", VLM_MODEL_ID)\n",
    "print(\"VLM output directory:\", VLM_OUTPUT_DIR.resolve())"
   ]
  },
