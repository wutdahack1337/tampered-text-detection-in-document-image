    "def get_masked_image(env, idx) -> Image.Image:\n",
    "    with env.begin() as txn:\n",
    "        image_buffer = txn.get((\"image-%09d\" % idx).encode(\"utf-8\"))\n",
    "        label_buffer = txn.get((\"label-%09d\" % idx).encode(\"utf-8\"))\n",
    "\n",
    "    image = Image.open(BytesIO(image_buffer)).convert(\"RGBA\")\n",
    "    label = Image.open(BytesIO(label_buffer))\n",
    "    \n",
    "    mask = np.array(label)\n",
    "\n",
    "    tmp = np.tile([0, 0, 0, 0], (*mask.shape, 1)).astype(np.uint8)\n",
    "    tmp[mask == 255] = [255, 0, 0, 255]\n",
    "    mask = Image.fromarray(tmp)\n",
    "    \n",
    "    del tmp\n",
    "    \n",
    "    return Image.blend(im1=image, im2=mask, alpha=0.3)\n",
    "\n",
    "def display_images(images: list[Image.Image]):\n",
    "    fig, axes = plt.subplots(1, len(images), figsize=(len(images)*4, 6))\n",
    "\n",
    "    for ax, img in zip(axes, images):\n",
    "        ax.imshow(img)\n",
    "        ax.axis(\"off\")\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "display_images([get_masked_image(envs[\"DocTamperV1-TrainingSet\"], i) for i in sample(population=range(0,200), k=3)])\n",
    "display_images([get_masked_image(envs[\"DocTamperV1-TestingSet\"], i) for i in sample(population=range(0,200), k=3)])\n",
    "display_images([get_masked_image(envs[\"DocTamperV1-SCD\"], i) for i in sample(population=range(0,200), k=3)])\n",
    "display_images([get_masked_image(envs[\"DocTamperV1-FCD\"], i) for i in sample(population=range(0,200), k=3)])"
   ]
  },
