    "# Remove training-only objects if they still exist.\n",
    "for _name in (\"optimizer\", \"scheduler\", \"scaler\", \"train_loader\", \"val_loader\"):\n",
    "    if _name in globals():\n",
    "        del globals()[_name]\n",
    "\n",
    "gc.collect()\n",
    "if torch.cuda.is_available():\n",
    "    torch.cuda.empty_cache()\n",
    "    print(torch.cuda.get_device_name(0))\n",
    "    print(\"CUDA allocated before vLLM:\", round(torch.cuda.memory_allocated() / 1024**3, 2), \"GiB\")\n",
    "else:\n",
    "    raise RuntimeError(\"A CUDA GPU is required for this vLLM configuration.\")"
   ]
