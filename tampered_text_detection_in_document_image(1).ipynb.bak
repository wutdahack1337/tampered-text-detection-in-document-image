   "source": [
    "@torch.no_grad()\n",
    "def visualize_predictions(model, dataset, device, num_samples=4, threshold=0.5):\n",
    "    model.eval()\n",
    "\n",
    "    if len(dataset) == 0:\n",
    "        print(\"Dataset is empty.\")\n",
    "        return\n",
    "\n",
    "    vis_rng = random.Random(SEED + 2)\n",
    "    selected_indices = vis_rng.sample(\n",
    "        range(len(dataset)),\n",
    "        k=min(num_samples, len(dataset))\n",
    "    )\n",
    "\n",
    "    fig, axes = plt.subplots(\n",
    "        len(selected_indices), 3,\n",
    "        figsize=(13, 4 * len(selected_indices)),\n",
    "        squeeze=False\n",
    "    )\n",
    "\n",
    "    for row, idx in enumerate(selected_indices):\n",
    "        image, mask = dataset[idx]\n",
    "\n",
    "        logits = model(image.unsqueeze(0).to(device))\n",
    "        prediction = (\n",
    "            torch.sigmoid(logits) >= threshold\n",
    "        ).float().squeeze().cpu().numpy()\n",
    "\n",
    "        # Undo ImageNet normalization for display only.\n",
    "        mean = torch.tensor(MEAN).view(3, 1, 1)\n",
    "        std = torch.tensor(STD).view(3, 1, 1)\n",
    "        image_for_display = (image.cpu() * std + mean).clamp(0, 1)\n",
    "        image_np = image_for_display.permute(1, 2, 0).numpy()\n",
    "        mask_np = mask.squeeze().cpu().numpy()\n",
    "\n",
    "        axes[row, 0].imshow(image_np)\n",
    "        axes[row, 0].set_title(\"Input image\")\n",
    "        axes[row, 1].imshow(mask_np, cmap=\"gray\", vmin=0, vmax=1)\n",
    "        axes[row, 1].set_title(\"Ground truth\")\n",
    "        axes[row, 2].imshow(prediction, cmap=\"gray\", vmin=0, vmax=1)\n",
    "        axes[row, 2].set_title(\"Prediction\")\n",
    "\n",
    "        for ax in axes[row]:\n",
    "            ax.axis(\"off\")\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "visualize_predictions(model, test_dataset, device, num_samples=20)"
   ]
  },
