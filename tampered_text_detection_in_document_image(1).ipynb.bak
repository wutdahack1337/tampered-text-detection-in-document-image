   "source": [
    "test_env = envs[\"DocTamperV1-TestingSet\"]\n",
    "n_test = get_num_samples(test_env)\n",
    "test_indices = np.arange(n_test)\n",
    "# This is for MVP\n",
    "test_indices = test_indices[:VAL_MVP]\n",
    "print(f\"Test sample: {len(test_indices):,}\")\n",
    "test_dataset = DocTamperDataset(test_env, test_indices, image_transform, mask_transform)\n",
    "test_loader = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=(device == \"cuda\"))\n",
    "test_results = evaluate(model, test_loader, device, threshold=0.5, dataset_name=\"Test\")\n",
    "\n",
    "\n",
    "fcd_env = envs[\"DocTamperV1-FCD\"]\n",
    "fcd_indices = np.arange(get_num_samples(fcd_env))\n",
    "# This is for MVP\n",
    "fcd_indices = fcd_indices[:VAL_MVP]\n",
    "print(f\"FCD sample: {len(fcd_indices):,}\")\n",
    "fcd_dataset = DocTamperDataset(fcd_env, fcd_indices, image_transform, mask_transform)\n",
    "fcd_loader = DataLoader(fcd_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=(device == \"cuda\"))\n",
    "fcd_results = evaluate(model, fcd_loader, device, threshold=0.5, dataset_name=\"FCD\")\n",
    "\n",
    "\n",
    "scd_env = envs[\"DocTamperV1-SCD\"]\n",
    "scd_indices = np.arange(get_num_samples(scd_env))\n",
    "# This is for MVP\n",
    "scd_indices = scd_indices[:VAL_MVP]\n",
    "print(f\"SCD sample: {len(scd_indices):,}\")\n",
    "scd_dataset = DocTamperDataset(scd_env, scd_indices, image_transform, mask_transform)\n",
    "scd_loader = DataLoader(scd_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=(device == \"cuda\"))\n",
    "scd_results = evaluate(model, scd_loader, device, threshold=0.5, dataset_name=\"SCD\")\n",
    "\n",
    "\n",
    "print(\"Avg Dice: \", (test_results[\"Macro_Dice\"] + fcd_results[\"Macro_Dice\"] + scd_results[\"Macro_Dice\"])/3)"
   ]
  },
