   "outputs": [],
   "source": [
    "def load_raw_lmdb_sample(env, sample_idx):\n",
    "    image_key = f\"image-{int(sample_idx):09d}\".encode(\"utf-8\")\n",
    "    label_key = f\"label-{int(sample_idx):09d}\".encode(\"utf-8\")\n",
    "\n",
    "    with env.begin(write=False) as txn:\n",
    "        image_buffer = txn.get(image_key)\n",
    "        label_buffer = txn.get(label_key)\n",
    "\n",
    "    if image_buffer is None:\n",
    "        raise KeyError(f\"Image key not found: {image_key!r}\")\n",
    "    if label_buffer is None:\n",
    "        raise KeyError(f\"Label key not found: {label_key!r}\")\n",
    "\n",
    "    original_image = Image.open(BytesIO(image_buffer)).convert(\"RGB\")\n",
    "    ground_truth_mask = Image.open(BytesIO(label_buffer)).convert(\"L\")\n",
    "    return original_image, ground_truth_mask\n",
    "\n",
    "\n",
    "@torch.inference_mode()\n",
    "def run_lightweight_dtd_on_pil(image_pil, threshold=VLM_THRESHOLD):\n",
    "    model.eval()\n",
    "    image_tensor = image_transform(image_pil).unsqueeze(0).to(device)\n",
    "\n",
    "    with torch.autocast(\n",
    "        device_type=\"cuda\",\n",
    "        dtype=torch.float16,\n",
    "        enabled=(device == \"cuda\"),\n",
    "    ):\n",
    "        logits = model(image_tensor)\n",
    "\n",
    "    probability = torch.sigmoid(logits)[0, 0].float().cpu().numpy()\n",
    "    binary_mask = (probability >= threshold).astype(np.uint8)\n",
    "\n",
    "    del image_tensor, logits\n",
    "    return probability, binary_mask"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "60649e38-8794-4114-a22b-0f363f265ec2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_detector_evidence(\n",
    "    original_image,\n",
    "    probability_map,\n",
    "    binary_mask,\n",
    "    min_area=VLM_MIN_COMPONENT_AREA,\n",
    "    max_regions=VLM_MAX_REGIONS,\n",
    "    crop_margin=VLM_CROP_MARGIN,\n",
    "):\n",
    "    image_np = np.asarray(original_image.convert(\"RGB\")).copy()\n",
    "    height, width = image_np.shape[:2]\n",
    "\n",
    "    if binary_mask.shape != (height, width):\n",
    "        binary_mask = cv2.resize(\n",
    "            binary_mask.astype(np.uint8),\n",
    "            (width, height),\n",
    "            interpolation=cv2.INTER_NEAREST,\n",
    "        )\n",
    "    if probability_map.shape != (height, width):\n",
    "        probability_map = cv2.resize(\n",
    "            probability_map.astype(np.float32),\n",
    "            (width, height),\n",
    "            interpolation=cv2.INTER_LINEAR,\n",
    "        )\n",
    "\n",
    "    overlay_np = image_np.copy()\n",
    "    red = np.zeros_like(overlay_np)\n",
    "    red[..., 0] = 255\n",
    "    selected = binary_mask.astype(bool)\n",
    "    overlay_np[selected] = (\n",
    "        0.55 * overlay_np[selected] + 0.45 * red[selected]\n",
    "    ).astype(np.uint8)\n",
    "\n",
    "    # Probability heatmap for inspection and saving.\n",
    "    heat = np.uint8(np.clip(probability_map, 0, 1) * 255)\n",
    "    heat_color = cv2.applyColorMap(heat, cv2.COLORMAP_JET)\n",
    "    heat_color = cv2.cvtColor(heat_color, cv2.COLOR_BGR2RGB)\n",
    "\n",
    "    count, labels, stats, _ = cv2.connectedComponentsWithStats(\n",
    "        binary_mask.astype(np.uint8), connectivity=8\n",
    "    )\n",
    "\n",
    "    candidates = []\n",
    "    for component_id in range(1, count):\n",
    "        x, y, w, h, area = stats[component_id]\n",
    "        if area < min_area:\n",
    "            continue\n",
    "\n",
    "        component_pixels = labels == component_id\n",
    "        mean_conf = float(probability_map[component_pixels].mean())\n",
    "        max_conf = float(probability_map[component_pixels].max())\n",
    "        score = mean_conf * float(np.sqrt(area))\n",
    "\n",
    "        x1 = max(0, int(x) - crop_margin)\n",
    "        y1 = max(0, int(y) - crop_margin)\n",
    "        x2 = min(width, int(x + w) + crop_margin)\n",
    "        y2 = min(height, int(y + h) + crop_margin)\n",
    "\n",
    "        candidates.append({\n",
    "            \"bbox_xyxy\": [int(x), int(y), int(x + w), int(y + h)],\n",
    "            \"area_pixels\": int(area),\n",
    "            \"mean_confidence\": round(mean_conf, 4),\n",
    "            \"max_confidence\": round(max_conf, 4),\n",
    "            \"ranking_score\": round(score, 4),\n",
    "            \"crop_xyxy\": [x1, y1, x2, y2],\n",
    "        })\n",
    "\n",
    "    candidates.sort(key=lambda item: item[\"ranking_score\"], reverse=True)\n",
    "    regions = candidates[:max_regions]\n",
    "\n",
    "    # Draw selected boxes and labels on a separate overlay.\n",
    "    boxed = overlay_np.copy()\n",
    "    draw = ImageDraw.Draw(Image.fromarray(boxed))\n",
    "    boxed_pil = Image.fromarray(boxed)\n",
    "    draw = ImageDraw.Draw(boxed_pil)\n",
    "    crops = []\n",
    "\n",
    "    for region_idx, region in enumerate(regions, start=1):\n",
    "        x1, y1, x2, y2 = region[\"bbox_xyxy\"]\n",
    "        cx1, cy1, cx2, cy2 = region[\"crop_xyxy\"]\n",
    "        draw.rectangle((x1, y1, x2, y2), outline=(255, 255, 0), width=3)\n",
    "        draw.text((x1, max(0, y1 - 14)), f\"R{region_idx}\", fill=(255, 255, 0))\n",
    "        crops.append(original_image.crop((cx1, cy1, cx2, cy2)))\n",
    "\n",
    "    return {\n",
    "        \"overlay\": Image.fromarray(overlay_np),\n",
    "        \"boxed_overlay\": boxed_pil,\n",
    "        \"heatmap\": Image.fromarray(heat_color),\n",
    "        \"regions\": regions,\n",
    "        \"crops\": crops,\n",
    "        \"predicted_pixel_ratio\": float(binary_mask.mean()),\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9557ce54-a595-4b92-9556-5e980ec67fa1",
   "metadata": {},
   "outputs": [],
   "source": [
    "SYSTEM_PROMPT = \"\"\"You are a careful assistant for document tampering analysis.\n",
    "You are given an original document image, an overlay produced by a segmentation detector,\n",
    "and up to two crops of regions selected by that detector.\n",
    "\n",
    "Rules:\n",
    "- The detector marks suspicious pixels; a highlighted region is NOT proof of tampering.\n",
    "- Describe only visual evidence that is actually visible.\n",
    "- Do not invent the original text, edited text, editing method, author, or intent.\n",
    "- If characters are too small or blurry to read, say so.\n",
    "- Separate observations from hypotheses.\n",
    "- Do not infer that two different font/spacing patterns prove manipulation by themselves.\n",
    "- If no meaningful region is highlighted, say that the detector did not produce a usable region.\n",
    "\n",
    "Return the answer in Vietnamese with these sections:\n",
    "1. Tóm tắt\n",
    "2. Vùng được detector đánh dấu\n",
    "3. Dấu hiệu quan sát được\n",
    "4. Điều chưa thể kết luận\n",
    "5. Đánh giá: đáng nghi / chưa đủ bằng chứng\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "def prepare_vllm_request(original_image, evidence):\n",
    "    content = [\n",
    "        {\n",
    "            \"type\": \"image\",\n",
    "            \"image\": original_image,\n",
    "            \"min_pixels\": 4 * 32 * 32,\n",
    "            \"max_pixels\": 512 * 32 * 32,\n",
    "        },\n",
    "        {\n",
    "            \"type\": \"image\",\n",
    "            \"image\": evidence[\"boxed_overlay\"],\n",
    "            \"min_pixels\": 4 * 32 * 32,\n",
    "            \"max_pixels\": 512 * 32 * 32,\n",
    "        },\n",
    "    ]\n",
    "\n",
    "    for crop in evidence[\"crops\"]:\n",
    "        content.append({\n",
    "            \"type\": \"image\",\n",
    "            \"image\": crop,\n",
    "            \"min_pixels\": 4 * 32 * 32,\n",
    "            \"max_pixels\": 256 * 32 * 32,\n",
    "        })\n",
    "\n",
    "    region_summary = [\n",
    "        {\n",
    "            \"region_id\": i + 1,\n",
    "            \"bbox_xyxy\": r[\"bbox_xyxy\"],\n",
    "            \"area_pixels\": r[\"area_pixels\"],\n",
    "            \"mean_confidence\": r[\"mean_confidence\"],\n",
    "            \"max_confidence\": r[\"max_confidence\"],\n",
    "        }\n",
    "        for i, r in enumerate(evidence[\"regions\"])\n",
    "    ]\n",
    "\n",
    "    user_text = f\"\"\"Analyze this document using the attached images.\n",
    "Image 1 is the original document.\n",
    "Image 2 is the detector overlay; yellow rectangles identify selected predicted regions.\n",
    "Following images, if present, are crops of those predicted regions.\n",
    "\n",
    "Detector metadata (model confidence is not the probability that tampering truly occurred):\n",
    "{json.dumps(region_summary, ensure_ascii=False, indent=2)}\n",
    "\n",
    "Predicted suspicious pixel ratio: {evidence['predicted_pixel_ratio']:.6f}\n",
    "\n",
    "Explain only what the images support. Do not claim certainty from the mask alone.\"\"\"\n",
    "\n",
    "    content.append({\"type\": \"text\", \"text\": user_text})\n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n",
    "        {\"role\": \"user\", \"content\": content},\n",
    "    ]\n",
    "\n",
    "    prompt_text = processor.apply_chat_template(\n",
    "        messages,\n",
    "        tokenize=False,\n",
    "        add_generation_prompt=True,\n",
    "    )\n",
    "\n",
    "    image_inputs, video_inputs, video_kwargs = process_vision_info(\n",
    "        messages,\n",
    "        image_patch_size=processor.image_processor.patch_size,\n",
    "        return_video_kwargs=True,\n",
    "        return_video_metadata=True,\n",
    "    )\n",
    "\n",
    "    multimodal_data = {}\n",
    "    if image_inputs is not None:\n",
    "        multimodal_data[\"image\"] = image_inputs\n",
    "    if video_inputs is not None:\n",
    "        multimodal_data[\"video\"] = video_inputs\n",
    "\n",
    "    request = {\n",
    "        \"prompt\": prompt_text,\n",
    "        \"multi_modal_data\": multimodal_data,\n",
    "    }\n",
    "    if video_kwargs:\n",
    "        request[\"mm_processor_kwargs\"] = video_kwargs\n",
    "\n",
    "    return request\n",
    "\n",
    "\n",
    "def explain_document_with_vllm(original_image, evidence):\n",
    "    request = prepare_vllm_request(original_image, evidence)\n",
    "    outputs = llm.generate([request], sampling_params=sampling_params)\n",
    "    return outputs[0].outputs[0].text"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "69f080d0-7f24-43aa-bdfb-1ec524b75fec",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1800x600 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "if VLM_SAMPLE_SPLIT not in envs:\n",
    "    raise KeyError(\n",
    "        f\"Unknown split {VLM_SAMPLE_SPLIT!r}. Available splits: {list(envs.keys())}\"\n",
    "    )\n",
    "\n",
    "sample_env = envs[VLM_SAMPLE_SPLIT]\n",
    "sample_count = get_num_samples(sample_env)\n",
    "if not (0 <= VLM_SAMPLE_INDEX < sample_count):\n",
    "    raise IndexError(\n",
    "        f\"VLM_SAMPLE_INDEX={VLM_SAMPLE_INDEX} is outside [0, {sample_count - 1}]\"\n",
    "    )\n",
    "\n",
    "original_image, ground_truth_mask = load_raw_lmdb_sample(\n",
    "    sample_env,\n",
    "    VLM_SAMPLE_INDEX,\n",
    ")\n",
    "probability_map, predicted_mask = run_lightweight_dtd_on_pil(\n",
    "    original_image,\n",
    "    threshold=VLM_THRESHOLD,\n",
    ")\n",
    "evidence = build_detector_evidence(\n",
    "    original_image,\n",
    "    probability_map,\n",
    "    predicted_mask,\n",
    ")\n",
    "\n",
    "print(\"Split:\", VLM_SAMPLE_SPLIT)\n",
    "print(\"Sample index:\", VLM_SAMPLE_INDEX)\n",
    "print(\"Image size:\", original_image.size)\n",
    "print(\"Predicted regions:\", len(evidence[\"regions\"]))\n",
    "print(\"Region metadata:\")\n",
    "print(json.dumps(evidence[\"regions\"], ensure_ascii=False, indent=2))\n",
    "\n",
    "# Ground truth is shown only for offline evaluation, never passed to the VLM.\n",
    "fig, axes = plt.subplots(1, 4, figsize=(18, 5))\n",
    "axes[0].imshow(original_image); axes[0].set_title(\"Original\")\n",
    "axes[1].imshow(evidence[\"boxed_overlay\"]); axes[1].set_title(\"Detector overlay\")\n",
    "axes[2].imshow(evidence[\"heatmap\"]); axes[2].set_title(\"Probability heatmap\")\n",
    "axes[3].imshow(ground_truth_mask, cmap=\"gray\"); axes[3].set_title(\"Ground truth (not sent to VLM)\")\n",
    "for ax in axes:\n",
    "    ax.axis(\"off\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "explanation = explain_document_with_vllm(original_image, evidence)\n",
    "print(\"\\n===== VLM EXPLANATION =====\\n\")\n",
    "print(explanation)"
   ]
  },
