   "source": [
    "class BCEDiceLoss(nn.Module):\n",
    "    def __init__(self, dice_weight=1.0, smooth=1.0):\n",
    "        super().__init__()\n",
    "        self.bce = nn.BCEWithLogitsLoss()\n",
    "        self.dice_weight = dice_weight\n",
    "        self.smooth = smooth\n",
    "\n",
    "    def forward(self, logits, targets):\n",
    "        logits = logits.float()  # compute the loss in fp32 even under autocast\n",
    "        bce = self.bce(logits, targets)\n",
    "        probs = torch.sigmoid(logits)\n",
    "        inter = (probs * targets).sum()\n",
    "        dice = (2.0 * inter + self.smooth) / (probs.sum() + targets.sum() + self.smooth)\n",
    "        return bce + self.dice_weight * (1.0 - dice)\n",
    "\n",
    "criterion = BCEDiceLoss()\n",
    "\n",
    "encoder_params = list(model.encoder.parameters())\n",
    "decoder_params = [\n",
    "    param\n",
    "    for name, param in model.named_parameters()\n",
    "    if not name.startswith(\"encoder.\")\n",
    "]\n",
    "optimizer = torch.optim.AdamW([\n",
    "    {\"params\": encoder_params, \"lr\": ENCODER_LR},\n",
    "    {\"params\": decoder_params, \"lr\": DECODER_LR},\n",
    "], weight_decay=WD)\n",
    "\n",
    "scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)\n",
    "scaler = torch.amp.GradScaler(\"cuda\", enabled=(device == \"cuda\"))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ee0a4821-f370-4c37-8567-0e4c40eac4c1",
   "metadata": {},
   "source": [
    "# Block 6: Training & Validation Loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "a789537d-6e19-4778-b040-f3001a7ceedc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def calculate_batch_dice(logits, masks, threshold=0.5, smooth=1e-6):\n",
    "    predictions = (torch.sigmoid(logits) >= threshold).float()\n",
    "    targets = (masks >= 0.5).float()\n",
    "\n",
    "    predictions = predictions.flatten(start_dim=1)\n",
    "    targets = targets.flatten(start_dim=1)\n",
    "\n",
    "    intersection = (predictions * targets).sum(dim=1)\n",
    "    pred_sum = predictions.sum(dim=1)\n",
    "    target_sum = targets.sum(dim=1)\n",
    "\n",
    "    dice = (2.0 * intersection + smooth) / (\n",
    "        pred_sum + target_sum + smooth\n",
    "    )\n",
    "\n",
    "    return dice.sum().item(), dice.numel()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "b9c42e38-1000-4119-bef7-0f89f9e939c9",
   "metadata": {},
   "outputs": [],
   "source": [
    "@torch.no_grad()\n",
    "def validate_one_epoch(model, loader, criterion):\n",
    "    model.eval()\n",
    "\n",
    "    running_loss = 0.0\n",
    "    total_dice = 0.0\n",
    "    total_images = 0\n",
    "\n",
    "    progress_bar = tqdm(loader, desc=\"Validation\")\n",
    "\n",
    "    for images, masks in progress_bar:\n",
    "        images = images.to(device, non_blocking=True)\n",
    "        masks = masks.to(device, non_blocking=True)\n",
    "\n",
    "        with torch.autocast(device_type=device, dtype=torch.float16, enabled=(device == \"cuda\")):\n",
    "            logits = model(images)\n",
    "            loss = criterion(logits, masks)\n",
    "\n",
    "        batch_size = images.size(0)\n",
    "        batch_dice_sum, num_images = calculate_batch_dice(logits, masks)\n",
    "\n",
    "        running_loss += loss.item() * batch_size\n",
    "        total_dice += batch_dice_sum\n",
    "        total_images += num_images\n",
    "\n",
    "        progress_bar.set_postfix(\n",
    "            loss=f\"{loss.item():.4f}\",\n",
    "            macro_dice=f\"{batch_dice_sum / num_images:.4f}\"\n",
    "        )\n",
    "\n",
    "    avg_loss = running_loss / len(loader.dataset)\n",
    "    avg_macro_dice = total_dice / total_images\n",
    "\n",
    "    return avg_loss, avg_macro_dice\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "3124da97-8587-4f2c-baa6-d9999f9f55a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def train_one_epoch(model, loader, criterion, optimizer, scaler):\n",
    "    model.train()\n",
    "    running_loss = 0.0\n",
    "\n",
    "    progress_bar = tqdm(loader, desc=\"Train\")\n",
    "\n",
    "    for images, masks in progress_bar:\n",
    "        images = images.to(device, non_blocking=True)\n",
    "        masks = masks.to(device, non_blocking=True)\n",
    "\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "\n",
    "        with torch.autocast(device_type=device, dtype=torch.float16, enabled=(device == \"cuda\")):\n",
    "            logits = model(images)\n",
    "            loss = criterion(logits, masks)\n",
    "\n",
    "        scaler.scale(loss).backward()\n",
    "        scaler.step(optimizer)\n",
    "        scaler.update()\n",
    "\n",
    "        batch_size = images.size(0)\n",
    "        running_loss += loss.item() * batch_size\n",
    "\n",
    "        progress_bar.set_postfix(loss=f\"{loss.item():.4f}\")\n",
    "\n",
    "    return running_loss / len(loader.dataset)"
   ]
  },
