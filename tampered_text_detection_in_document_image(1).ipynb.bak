   "source": [
    "def get_num_samples(env):\n",
    "    with env.begin() as txn:\n",
    "        value = txn.get(b\"num-samples\")\n",
    "\n",
    "    return int(value.decode(\"utf-8\"))\n",
    "\n",
    "\n",
    "train_env = envs[\"DocTamperV1-TrainingSet\"]\n",
    "\n",
    "\n",
    "n_train = get_num_samples(train_env)\n",
    "\n",
    "\n",
    "all_train_indices = np.arange(n_train)\n",
    "\n",
    "\n",
    "train_indices, val_indices = train_test_split(all_train_indices, test_size=TEST_SIZE, random_state=SEED, shuffle=True)\n",
    "\n",
    "# This is for MVP\n",
    "train_indices = train_indices[:TRAIN_MVP]\n",
    "val_indices = val_indices[:VAL_MVP]\n",
    "\n",
    "print(f\"Train samples: {len(train_indices):,}\")\n",
    "print(f\"Validation samples: {len(val_indices):,}\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "7d293775-db5a-4fd5-b8b1-4424d587ada3",
   "metadata": {},
   "outputs": [],
   "source": [
    "image_transform = transforms.Compose([\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(MEAN, STD),\n",
    "])\n",
    "\n",
    "mask_transform = transforms.Compose([\n",
    "    transforms.ToTensor(),\n",
    "])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d0c09d6b-2024-4444-b333-05867fa2d054",
   "metadata": {},
   "source": [
    "# Block 4: Dataset & Data Loader"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "94892982-e553-45c6-912f-6dd47ed58c0e",
   "metadata": {},
   "outputs": [],
   "source": [
    "class DocTamperDataset(Dataset):\n",
    "    def __init__(self, env, indices, image_transform, mask_transform):\n",
    "        self.env = env\n",
    "        self.indices = indices\n",
    "        self.image_transform = image_transform\n",
    "        self.mask_transform = mask_transform \n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.indices)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        sample_idx = int(self.indices[index])\n",
    "\n",
    "        image_key = f\"image-{sample_idx:09d}\".encode(\"utf-8\")\n",
    "        label_key = f\"label-{sample_idx:09d}\".encode(\"utf-8\")\n",
    "\n",
    "        with self.env.begin() as txn:\n",
    "            image_buffer = txn.get(image_key)\n",
    "            label_buffer = txn.get(label_key)\n",
    "\n",
    "        image = Image.open(BytesIO(image_buffer)).convert(\"RGB\")\n",
    "        mask = Image.open(BytesIO(label_buffer)).convert(\"L\")\n",
    "\n",
    "        image_tensor = self.image_transform(image)\n",
    "        mask_tensor = (self.mask_transform(mask) > 0.5).float()\n",
    "\n",
    "        return image_tensor, mask_tensor\n",
    "\n",
    "train_dataset = DocTamperDataset(train_env, train_indices, image_transform, mask_transform)\n",
    "val_dataset = DocTamperDataset(train_env, val_indices, image_transform, mask_transform)\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=NUM_WORKERS, pin_memory=(device == \"cuda\"), persistent_workers=(NUM_WORKERS > 0))\n",
    "val_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=(device == \"cuda\"), persistent_workers=(NUM_WORKERS > 0))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "27ebe8b5-3956-4d9c-94b9-4f668976ed2b",
   "metadata": {},
   "source": [
    "# Block 5: Modeling & Hyperparameter"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "d08b776f-02b4-4c5c-96eb-0baabd287e98",
   "metadata": {},
   "outputs": [],
   "source": [
    "class DepthwiseSeparableBlock(nn.Module):\n",
    "    \"\"\"Lightweight pointwise + depthwise + pointwise convolution block.\"\"\"\n",
    "    def __init__(self, in_channels, out_channels):\n",
    "        super().__init__()\n",
    "        self.block = nn.Sequential(\n",
    "            nn.Conv2d(in_channels, out_channels, kernel_size=1, bias=False),\n",
    "            nn.BatchNorm2d(out_channels),\n",
    "            nn.ReLU(inplace=True),\n",
    "\n",
    "            nn.Conv2d(\n",
    "                out_channels, out_channels,\n",
    "                kernel_size=3, padding=1,\n",
    "                groups=out_channels, bias=False\n",
    "            ),\n",
    "            nn.BatchNorm2d(out_channels),\n",
    "            nn.ReLU(inplace=True),\n",
    "\n",
    "            nn.Conv2d(out_channels, out_channels, kernel_size=1, bias=False),\n",
    "            nn.BatchNorm2d(out_channels),\n",
    "            nn.ReLU(inplace=True),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.block(x)\n",
    "\n",
    "\n",
    "class SCSEModule(nn.Module):\n",
    "    \"\"\"Concurrent channel and spatial squeeze-excitation.\"\"\"\n",
    "    def __init__(self, channels, reduction=8):\n",
    "        super().__init__()\n",
    "        hidden = max(channels // reduction, 4)\n",
    "\n",
    "        self.channel_attention = nn.Sequential(\n",
    "            nn.AdaptiveAvgPool2d(1),\n",
    "            nn.Conv2d(channels, hidden, kernel_size=1),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Conv2d(hidden, channels, kernel_size=1),\n",
    "            nn.Sigmoid(),\n",
    "        )\n",
    "\n",
    "        self.spatial_attention = nn.Sequential(\n",
    "            nn.Conv2d(channels, 1, kernel_size=1),\n",
    "            nn.Sigmoid(),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        channel_features = x * self.channel_attention(x)\n",
    "        spatial_features = x * self.spatial_attention(x)\n",
    "        return channel_features + spatial_features\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "0cf8e45a-90ba-4e04-844b-a3368468585d",
   "metadata": {},
   "outputs": [],
   "source": [
    "class BlockDCT(nn.Module):\n",
    "    \"\"\"Orthonormal 8x8 block DCT; output: [B, 64, H/8, W/8].\"\"\"\n",
    "    def __init__(self, block_size=8, mean=MEAN, std=STD):\n",
    "        super().__init__()\n",
    "        self.block_size = block_size\n",
    "        self.register_buffer(\"mean\", torch.tensor(mean).view(1, 3, 1, 1))\n",
    "        self.register_buffer(\"std\", torch.tensor(std).view(1, 3, 1, 1))\n",
    "\n",
    "        # Build the orthonormal DCT-II basis.\n",
    "        n = block_size\n",
    "        basis = torch.empty(n, n, dtype=torch.float32)\n",
    "        for u in range(n):\n",
    "            alpha = (1.0 / n) ** 0.5 if u == 0 else (2.0 / n) ** 0.5\n",
    "            for pos in range(n):\n",
    "                basis[u, pos] = alpha * torch.cos(\n",
    "                    torch.tensor((2 * pos + 1) * u * torch.pi / (2 * n))\n",
    "                )\n",
    "        self.register_buffer(\"basis\", basis)\n",
    "\n",
    "    def forward(self, image):\n",
    "        # The input image is ImageNet-normalized. Recover RGB in [0, 1].\n",
    "        # Run fixed DCT operations in FP32 for numerical stability under AMP.\n",
    "        with torch.autocast(device_type=image.device.type, enabled=False):\n",
    "            image = image.float() * self.std + self.mean\n",
    "            image = image.clamp(0.0, 1.0)\n",
    "\n",
    "            gray = (\n",
    "                0.299 * image[:, 0:1]\n",
    "                + 0.587 * image[:, 1:2]\n",
    "                + 0.114 * image[:, 2:3]\n",
    "            )\n",
    "\n",
    "            batch_size, _, height, width = gray.shape\n",
    "            n = self.block_size\n",
    "            pad_h = (n - height % n) % n\n",
    "            pad_w = (n - width % n) % n\n",
    "\n",
    "            if pad_h or pad_w:\n",
    "                gray = F.pad(gray, (0, pad_w, 0, pad_h), mode=\"replicate\")\n",
    "\n",
    "            # Non-overlapping 8x8 blocks.\n",
    "            patches = F.unfold(gray, kernel_size=n, stride=n)\n",
    "            grid_h = gray.shape[-2] // n\n",
    "            grid_w = gray.shape[-1] // n\n",
    "            patches = patches.transpose(1, 2).reshape(\n",
    "                batch_size, grid_h * grid_w, n, n\n",
    "            )\n",
    "\n",
    "            basis = self.basis.to(device=image.device, dtype=torch.float32)\n",
    "            coeff = torch.matmul(basis, patches)\n",
    "            coeff = torch.matmul(coeff, basis.t())\n",
    "\n",
    "            # [B, number_of_blocks, 8, 8] -> [B, 64, grid_h, grid_w]\n",
    "            coeff = coeff.reshape(batch_size, grid_h, grid_w, n, n)\n",
    "            coeff = coeff.permute(0, 3, 4, 1, 2).contiguous()\n",
    "            coeff = coeff.reshape(batch_size, n * n, grid_h, grid_w)\n",
    "\n",
    "            # Signed log compression of coefficient range.\n",
    "            coeff = torch.sign(coeff) * torch.log1p(torch.abs(coeff) * 8.0)\n",
    "\n",
    "        return coeff\n",
    "\n",
    "\n",
    "class LightweightFrequencyHead(nn.Module):\n",
    "    \"\"\"Small DCT feature encoder; original JPEG QT embedding is omitted.\"\"\"\n",
    "    def __init__(self, out_channels=32):\n",
    "        super().__init__()\n",
    "        self.block_dct = BlockDCT(block_size=8)\n",
    "\n",
    "        self.projection = nn.Sequential(\n",
    "            nn.Conv2d(64, out_channels, kernel_size=1, bias=False),\n",
    "            nn.BatchNorm2d(out_channels),\n",
    "            nn.ReLU(inplace=True),\n",
    "        )\n",
    "        self.refine = DepthwiseSeparableBlock(out_channels, out_channels)\n",
    "\n",
    "    def forward(self, image):\n",
    "        dct_map = self.block_dct(image)\n",
    "        features = self.projection(dct_map)\n",
    "        return self.refine(features)\n"
   ]
  },
