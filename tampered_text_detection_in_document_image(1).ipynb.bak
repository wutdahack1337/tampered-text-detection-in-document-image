     ]
    }
   ],
   "source": [
    "sample_tag = f\"{VLM_SAMPLE_SPLIT.replace('/', '_')}_{VLM_SAMPLE_INDEX:06d}\"\n",
    "\n",
    "original_path = VLM_OUTPUT_DIR / f\"{sample_tag}_original.png\"\n",
    "overlay_path = VLM_OUTPUT_DIR / f\"{sample_tag}_overlay.png\"\n",
    "heatmap_path = VLM_OUTPUT_DIR / f\"{sample_tag}_heatmap.png\"\n",
    "report_path = VLM_OUTPUT_DIR / f\"{sample_tag}_explanation.txt\"\n",
    "metadata_path = VLM_OUTPUT_DIR / f\"{sample_tag}_metadata.json\"\n",
    "\n",
    "original_image.save(original_path)\n",
    "evidence[\"boxed_overlay\"].save(overlay_path)\n",
    "evidence[\"heatmap\"].save(heatmap_path)\n",
    "report_path.write_text(explanation, encoding=\"utf-8\")\n",
    "metadata_path.write_text(\n",
    "    json.dumps({\n",
    "        \"split\": VLM_SAMPLE_SPLIT,\n",
    "        \"sample_index\": VLM_SAMPLE_INDEX,\n",
    "        \"threshold\": VLM_THRESHOLD,\n",
    "        \"predicted_pixel_ratio\": evidence[\"predicted_pixel_ratio\"],\n",
    "        \"regions\": evidence[\"regions\"],\n",
    "        \"note\": \"Ground-truth mask was not provided to the VLM.\",\n",
    "    }, ensure_ascii=False, indent=2),\n",
    "    encoding=\"utf-8\",\n",
    ")\n",
    "\n",
    "print(\"Saved files:\")\n",
    "for path in [original_path, overlay_path, heatmap_path, report_path, metadata_path]:\n",
    "    print(path.resolve())"
   ]
  },
