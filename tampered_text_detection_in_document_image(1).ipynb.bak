      "\u001b[36mFile \u001b[39m\u001b[32m/opt/conda/lib/python3.11/site-packages/vllm/v1/engine/core_client.py:699\u001b[39m, in \u001b[36mMPClient.__init__\u001b[39m\u001b[34m(self, asyncio_mode, vllm_config, executor_class, log_stats, client_addresses, renderer)\u001b[39m\n\u001b[32m    688\u001b[39m \u001b[38;5;66;03m# EngineZmqAddresses contains only endpoints resolved by the\u001b[39;00m\n\u001b[32m    689\u001b[39m \u001b[38;5;66;03m# sockets that own the bind operation.\u001b[39;00m\n\u001b[32m    690\u001b[39m addresses = EngineZmqAddresses(\n\u001b[32m    691\u001b[39m     inputs=[\u001b[38;5;28mself\u001b[39m.input_socket.getsockopt(zmq.LAST_ENDPOINT).decode()],\n\u001b[32m    692\u001b[39m     outputs=[\n\u001b[32m   (...)\u001b[39m\u001b[32m    696\u001b[39m     ],\n\u001b[32m    697\u001b[39m )\n\u001b[32m--> \u001b[39m\u001b[32m699\u001b[39m \u001b[43m\u001b[49m\u001b[38;5;28;43;01mwith\u001b[39;49;00m\u001b[43m \u001b[49m\u001b[43mlaunch_core_engines\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m    700\u001b[39m \u001b[43m    \u001b[49m\u001b[43mvllm_config\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mexecutor_class\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mlog_stats\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43maddresses\u001b[49m\n\u001b[32m    701\u001b[39m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;28;43;01mas\u001b[39;49;00m\u001b[43m \u001b[49m\u001b[43mengine_launch\u001b[49m\u001b[43m:\u001b[49m\n\u001b[32m    702\u001b[39m \u001b[43m    \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mresources\u001b[49m\u001b[43m.\u001b[49m\u001b[43mcoordinator\u001b[49m\u001b[43m \u001b[49m\u001b[43m=\u001b[49m\u001b[43m \u001b[49m\u001b[43mengine_launch\u001b[49m\u001b[43m.\u001b[49m\u001b[43mcoordinator\u001b[49m\n\u001b[32m    703\u001b[39m \u001b[43m    \u001b[49m\u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43mresources\u001b[49m\u001b[43m.\u001b[49m\u001b[43mengine_manager\u001b[49m\u001b[43m \u001b[49m\u001b[43m=\u001b[49m\u001b[43m \u001b[49m\u001b[43mengine_launch\u001b[49m\u001b[43m.\u001b[49m\u001b[43mengine_manager\u001b[49m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m/opt/conda/lib/python3.11/contextlib.py:144\u001b[39m, in \u001b[36m_GeneratorContextManager.__exit__\u001b[39m\u001b[34m(self, typ, value, traceback)\u001b[39m\n\u001b[32m    142\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m typ \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n\u001b[32m    143\u001b[39m     \u001b[38;5;28;01mtry\u001b[39;00m:\n\u001b[32m--> \u001b[39m\u001b[32m144\u001b[39m         \u001b[38;5;28mnext\u001b[39m(\u001b[38;5;28mself\u001b[39m.gen)\n\u001b[32m    145\u001b[39m     \u001b[38;5;28;01mexcept\u001b[39;00m \u001b[38;5;167;01mStopIteration\u001b[39;00m:\n\u001b[32m    146\u001b[39m         \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[38;5;28;01mFalse\u001b[39;00m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m/opt/conda/lib/python3.11/site-packages/vllm/v1/engine/utils.py:1393\u001b[39m, in \u001b[36mlaunch_core_engines\u001b[39m\u001b[34m(vllm_config, executor_class, log_stats, addresses)\u001b[39m\n\u001b[32m   1389\u001b[39m launch = CoreEngineLaunch(\n\u001b[32m   1390\u001b[39m     local_engine_manager, coordinator, addresses, tensor_queue\n\u001b[32m   1391\u001b[39m )\n\u001b[32m   1392\u001b[39m \u001b[38;5;28;01myield\u001b[39;00m launch\n\u001b[32m-> \u001b[39m\u001b[32m1393\u001b[39m \u001b[43mwait_for_engine_startup\u001b[49m\u001b[43m(\u001b[49m\n\u001b[32m   1394\u001b[39m \u001b[43m    \u001b[49m\u001b[43mhandshake_socket\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1395\u001b[39m \u001b[43m    \u001b[49m\u001b[43mengines_to_handshake\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1396\u001b[39m \u001b[43m    \u001b[49m\u001b[43mparallel_config\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1397\u001b[39m \u001b[43m    \u001b[49m\u001b[43mdp_size\u001b[49m\u001b[43m \u001b[49m\u001b[43m>\u001b[49m\u001b[43m \u001b[49m\u001b[32;43m1\u001b[39;49m\u001b[43m \u001b[49m\u001b[38;5;129;43;01mand\u001b[39;49;00m\u001b[43m \u001b[49m\u001b[43mvllm_config\u001b[49m\u001b[43m.\u001b[49m\u001b[43mmodel_config\u001b[49m\u001b[43m.\u001b[49m\u001b[43mis_moe\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1398\u001b[39m \u001b[43m    \u001b[49m\u001b[43mvllm_config\u001b[49m\u001b[43m.\u001b[49m\u001b[43mcache_config\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1399\u001b[39m \u001b[43m    \u001b[49m\u001b[43mlaunch\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m   1400\u001b[39m \u001b[43m\u001b[49m\u001b[43m)\u001b[49m\n",
      "\u001b[36mFile \u001b[39m\u001b[32m/opt/conda/lib/python3.11/site-packages/vllm/v1/engine/utils.py:1473\u001b[39m, in \u001b[36mwait_for_engine_startup\u001b[39m\u001b[34m(handshake_socket, core_engines, parallel_config, coordinated_dp, cache_config, launch)\u001b[39m\n\u001b[32m   1467\u001b[39m     \u001b[38;5;28;01mif\u001b[39;00m failed_frontend_procs \u001b[38;5;129;01mand\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m finished:\n\u001b[32m   1468\u001b[39m         \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mRuntimeError\u001b[39;00m(\n\u001b[32m   1469\u001b[39m             \u001b[33m\"\u001b[39m\u001b[33mFrontend process failed during engine core initialization. \u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m   1470\u001b[39m             \u001b[33m\"\u001b[39m\u001b[33mSee root cause above. \u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m   1471\u001b[39m             \u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[33mFailed frontend proc(s): \u001b[39m\u001b[38;5;132;01m{\u001b[39;00mfailed_frontend_procs\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m\"\u001b[39m\n\u001b[32m   1472\u001b[39m         )\n\u001b[32m-> \u001b[39m\u001b[32m1473\u001b[39m     \u001b[38;5;28;01mraise\u001b[39;00m \u001b[38;5;167;01mRuntimeError\u001b[39;00m(\n\u001b[32m   1474\u001b[39m         \u001b[33m\"\u001b[39m\u001b[33mEngine core initialization failed. \u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m   1475\u001b[39m         \u001b[33m\"\u001b[39m\u001b[33mSee root cause above. \u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m   1476\u001b[39m         \u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[33mFailed core proc(s): \u001b[39m\u001b[38;5;132;01m{\u001b[39;00mfinished\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m\"\u001b[39m\n\u001b[32m   1477\u001b[39m         + (\n\u001b[32m   1478\u001b[39m             \u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[33m, failed frontend proc(s): \u001b[39m\u001b[38;5;132;01m{\u001b[39;00mfailed_frontend_procs\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m\"\u001b[39m\n\u001b[32m   1479\u001b[39m             \u001b[38;5;28;01mif\u001b[39;00m failed_frontend_procs\n\u001b[32m   1480\u001b[39m             \u001b[38;5;28;01melse\u001b[39;00m \u001b[33m\"\u001b[39m\u001b[33m\"\u001b[39m\n\u001b[32m   1481\u001b[39m         )\n\u001b[32m   1482\u001b[39m     )\n\u001b[32m   1484\u001b[39m \u001b[38;5;66;03m# Receive HELLO and READY messages from the input socket.\u001b[39;00m\n\u001b[32m   1485\u001b[39m eng_identity, ready_msg_bytes = handshake_socket.recv_multipart()\n",
      "\u001b[31mRuntimeError\u001b[39m: Engine core initialization failed. See root cause above. Failed core proc(s): {}"
     ]
    }
   ],
   "source": [
    "# Load the processor metadata/template. This does NOT load model weights.\n",
    "processor = AutoProcessor.from_pretrained(VLM_MODEL_ID)\n",
    "\n",
    "# vLLM is the actual model runtime.\n",
    "llm = LLM(\n",
    "    model=VLM_MODEL_ID,\n",
    "    dtype=\"half\",\n",
    "    trust_remote_code=True,\n",
    "    gpu_memory_utilization=VLLM_GPU_MEMORY_UTILIZATION,\n",
    "    max_model_len=VLLM_MAX_MODEL_LEN,\n",
    "    max_num_seqs=VLLM_MAX_NUM_SEQS,\n",
    "    limit_mm_per_prompt={\"image\": VLLM_MAX_IMAGES_PER_PROMPT},\n",
    "    enforce_eager=True,\n",
    ")\n",
    "\n",
    "sampling_params = SamplingParams(\n",
    "    temperature=0.1,\n",
    "    top_p=0.9,\n",
    "    max_tokens=VLM_MAX_NEW_TOKENS,\n",
    "    repetition_penalty=1.05,\n",
    ")\n",
    "\n",
    "print(\"Qwen3-VL initialized with vLLM.\")"
   ]
  },
