   "source": [
    "# Check the already-installed runtime. No venv creation and no vLLM installation here.\n",
    "import importlib.metadata as metadata\n",
    "\n",
    "try:\n",
    "    vllm_version = metadata.version(\"vllm\")\n",
    "except metadata.PackageNotFoundError as exc:\n",
    "    raise RuntimeError(\n",
    "        \"vLLM is not installed in this Python kernel. Activate/select the existing \"\n",
    "        \"environment where vLLM is installed, then restart the kernel.\"\n",
    "    ) from exc\n",
    "\n",
    "try:\n",
    "    from packaging.version import Version\n",
    "    if Version(vllm_version) < Version(\"0.11.0\"):\n",
    "        raise RuntimeError(\n",
    "            f\"Detected vLLM {vllm_version}. Qwen3-VL support in the official Qwen guide \"\n",
    "            \"requires vLLM >= 0.11.0. Upgrade vLLM in your existing environment; \"\n",
    "            \"this notebook will not create a new environment.\"\n",
    "        )\n",
    "except ImportError:\n",
    "    print(\"Could not compare vLLM version because packaging is unavailable:\", vllm_version)\n",
    "\n",
    "try:\n",
    "    from qwen_vl_utils import process_vision_info\n",
    "except ImportError as exc:\n",
    "    raise RuntimeError(\n",
    "        \"Missing qwen-vl-utils. Install qwen-vl-utils==0.0.14 in the existing Python \"\n",
    "        \"environment (no virtual environment is needed), then restart the kernel.\"\n",
    "    ) from exc\n",
    "\n",
    "# Qwen's official vLLM offline example uses AutoProcessor for formatting/preprocessing.\n",
    "# The VLM weights and generation engine are loaded by vLLM, not Transformers.\n",
    "from transformers import AutoProcessor\n",
    "from vllm import LLM, SamplingParams\n",
    "\n",
    "# Recommended by the official Qwen3-VL vLLM offline example.\n",
    "os.environ.setdefault(\"VLLM_WORKER_MULTIPROC_METHOD\", \"spawn\")\n",
    "\n",
    "print(\"vLLM version:\", vllm_version)\n",
    "print(\"Qwen-VL utilities: available\")"
   ]
  },
