   "source": [
    "class LiteMID(nn.Module):\n",
    "    \"\"\"\n",
    "    Lightweight approximation of DTD's Multi-view Iterative Decoder.\n",
    "\n",
    "    Inputs are ordered from high to low spatial resolution:\n",
    "      f0: [B, 24,   H/4,  W/4]\n",
    "      f1: [B, 40,   H/8,  W/8]   (already fused with DCT features)\n",
    "      f2: [B, 112,  H/16, W/16]\n",
    "      f3: [B, 1280, H/32, W/32]\n",
    "\n",
    "    The decoder builds a small nested decoding grid:\n",
    "      first view:  x00, x11, x22\n",
    "      second view: x01, x12\n",
    "      final view:  x02\n",
    "\n",
    "    This preserves the iterative multi-scale aggregation idea while\n",
    "    using depthwise-separable convolutions to reduce compute.\n",
    "    \"\"\"\n",
    "    def __init__(self, in_channels=(24, 40, 112, 1280), width=48):\n",
    "        super().__init__()\n",
    "\n",
    "        self.projections = nn.ModuleList([\n",
    "            nn.Sequential(\n",
    "                nn.Conv2d(ch, width, kernel_size=1, bias=False),\n",
    "                nn.BatchNorm2d(width),\n",
    "                nn.ReLU(inplace=True),\n",
    "            )\n",
    "            for ch in in_channels\n",
    "        ])\n",
    "\n",
    "        # View 1: adjacent-scale decoding.\n",
    "        self.x00 = DepthwiseSeparableBlock(width * 2, width)\n",
    "        self.x11 = DepthwiseSeparableBlock(width * 2, width)\n",
    "        self.x22 = DepthwiseSeparableBlock(width * 2, width)\n",
    "\n",
    "        # View 2: aggregate the previous view and encoder skip features.\n",
    "        self.x01 = DepthwiseSeparableBlock(width * 3, width)\n",
    "        self.x12 = DepthwiseSeparableBlock(width * 3, width)\n",
    "\n",
    "        # View 3: final iterative aggregation at H/4.\n",
    "        self.x02 = DepthwiseSeparableBlock(width * 4, width)\n",
    "\n",
    "        self.refine = SCSEModule(width)\n",
    "\n",
    "    @staticmethod\n",
    "    def upsample_to(x, reference):\n",
    "        return F.interpolate(\n",
    "            x,\n",
    "            size=reference.shape[-2:],\n",
    "            mode=\"bilinear\",\n",
    "            align_corners=False,\n",
    "        )\n",
    "\n",
    "    def forward(self, f0, f1, f2, f3):\n",
    "        # Project all encoder scales to a compact common channel width.\n",
    "        p0, p1, p2, p3 = [\n",
    "            projection(feature)\n",
    "            for projection, feature in zip(\n",
    "                self.projections, (f0, f1, f2, f3)\n",
    "            )\n",
    "        ]\n",
    "\n",
    "        # View 1: coarse-to-fine decoding on adjacent scales.\n",
    "        x00 = self.x00(torch.cat([\n",
    "            self.upsample_to(p3, p2), p2\n",
    "        ], dim=1))\n",
    "\n",
    "        x11 = self.x11(torch.cat([\n",
    "            self.upsample_to(p2, p1), p1\n",
    "        ], dim=1))\n",
    "\n",
    "        x22 = self.x22(torch.cat([\n",
    "            self.upsample_to(p1, p0), p0\n",
    "        ], dim=1))\n",
    "\n",
    "        # View 2: iterative fusion of decoder outputs and encoder features.\n",
    "        x01 = self.x01(torch.cat([\n",
    "            self.upsample_to(x00, x11),\n",
    "            x11,\n",
    "            p1,\n",
    "        ], dim=1))\n",
    "\n",
    "        x12 = self.x12(torch.cat([\n",
    "            self.upsample_to(x11, x22),\n",
    "            x22,\n",
    "            p0,\n",
    "        ], dim=1))\n",
    "\n",
    "        # View 3: final multi-view aggregation at 1/4 resolution.\n",
    "        x02 = self.x02(torch.cat([\n",
    "            self.upsample_to(x01, x22),\n",
    "            x12,\n",
    "            x22,\n",
    "            p0,\n",
    "        ], dim=1))\n",
    "\n",
    "        return self.refine(x02)\n",
    "\n",
    "\n",
    "class LightweightDTD(nn.Module):\n",
    "    \"\"\"\n",
    "    DTD-inspired lightweight model:\n",
    "      - Spatial branch: EfficientNet-B0\n",
    "      - Frequency branch: block-wise 8x8 DCT\n",
    "      - Fusion: scSE + 1x1 projection at 1/8 resolution\n",
    "      - Decoder: LiteMID (nested multi-view iterative decoder)\n",
    "\n",
    "    This is not a reproduction of the original DTD MID. It is a\n",
    "    compute-conscious approximation of its multi-view iterative idea.\n",
    "    \"\"\"\n",
    "    def __init__(\n",
    "        self,\n",
    "        pretrained=True,\n",
    "        out_channels=1,\n",
    "        frequency_channels=32,\n",
    "        decoder_width=48,\n",
    "    ):\n",
    "        super().__init__()\n",
    "\n",
    "        weights = EfficientNet_B0_Weights.DEFAULT if pretrained else None\n",
    "        backbone = efficientnet_b0(weights=weights)\n",
    "        self.encoder = backbone.features\n",
    "\n",
    "        self.frequency_branch = LightweightFrequencyHead(\n",
    "            out_channels=frequency_channels\n",
    "        )\n",
    "\n",
    "        self.frequency_fusion = nn.Sequential(\n",
    "            SCSEModule(40 + frequency_channels),\n",
    "            nn.Conv2d(\n",
    "                40 + frequency_channels,\n",
    "                40,\n",
    "                kernel_size=1,\n",
    "                bias=False,\n",
    "            ),\n",
    "            nn.BatchNorm2d(40),\n",
    "            nn.ReLU(inplace=True),\n",
    "        )\n",
    "\n",
    "        self.decoder = LiteMID(\n",
    "            in_channels=(24, 40, 112, 1280),\n",
    "            width=decoder_width,\n",
    "        )\n",
    "\n",
    "        self.segmentation_head = nn.Conv2d(\n",
    "            decoder_width,\n",
    "            out_channels,\n",
    "            kernel_size=1,\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        input_size = x.shape[-2:]\n",
    "\n",
    "        # EfficientNet-B0 feature taps:\n",
    "        # features[2]: 24 channels, stride 4\n",
    "        # features[3]: 40 channels, stride 8\n",
    "        # features[5]: 112 channels, stride 16\n",
    "        # features[8]: 1280 channels, stride 32\n",
    "        z = x\n",
    "        f0 = f1 = f2 = f3 = None\n",
    "\n",
    "        for idx, layer in enumerate(self.encoder):\n",
    "            z = layer(z)\n",
    "\n",
    "            if idx == 2:\n",
    "                f0 = z\n",
    "            elif idx == 3:\n",
    "                f1 = z\n",
    "            elif idx == 5:\n",
    "                f2 = z\n",
    "            elif idx == 8:\n",
    "                f3 = z\n",
    "\n",
    "        # DCT frequency features are fused at the 1/8 scale.\n",
    "        freq = self.frequency_branch(x)\n",
    "\n",
    "        if freq.shape[-2:] != f1.shape[-2:]:\n",
    "            freq = F.interpolate(\n",
    "                freq,\n",
    "                size=f1.shape[-2:],\n",
    "                mode=\"bilinear\",\n",
    "                align_corners=False,\n",
    "            )\n",
    "\n",
    "        f1 = self.frequency_fusion(\n",
    "            torch.cat([f1, freq], dim=1)\n",
    "        )\n",
    "\n",
    "        # Four-scale iterative decoder.\n",
    "        decoded = self.decoder(f0, f1, f2, f3)\n",
    "\n",
    "        logits = self.segmentation_head(decoded)\n",
    "\n",
    "        return F.interpolate(\n",
    "            logits,\n",
    "            size=input_size,\n",
    "            mode=\"bilinear\",\n",
    "            align_corners=False,\n",
    "        )\n",
    "\n",
    "\n",
    "model = LightweightDTD(\n",
    "    pretrained=True,\n",
    "    out_channels=1,\n",
    "    frequency_channels=32,\n",
    "    decoder_width=48,\n",
    ").to(device)"
   ]
  },
